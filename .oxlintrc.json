{
	"$schema": "https://unpkg.com/oxlint/configuration_schema.json",
	"ignorePatterns": ["packages/definitions/**/lib/lexicons/**"],
	"categories": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"curly": "warn",
		"no-await-in-loop": "off",
		"no-shadow": "off",
		"no-underscore-dangle": "off",
		"unicorn/prefer-add-event-listener": "off"
	}
}
