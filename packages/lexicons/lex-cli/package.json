{
	"type": "module",
	"name": "@atcute/lex-cli",
	"version": "2.5.2",
	"description": "cli tool to generate type definitions for atcute",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lex-cli"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts",
		"cli.mjs",
		"schema/"
	],
	"bin": "./cli.mjs",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "pnpm run generate:schema && tsgo",
		"generate:schema": "node scripts/generate-schema.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/identity": "workspace:^",
		"@atcute/identity-resolver": "workspace:^",
		"@atcute/lexicon-doc": "workspace:^",
		"@atcute/lexicon-resolver": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@badrap/valita": "^0.4.6",
		"@optique/core": "^0.6.3",
		"@optique/run": "^0.6.3",
		"picocolors": "^1.1.1",
		"prettier": "^3.7.1"
	},
	"devDependencies": {
		"@types/node": "^22.19.1",
		"tschema": "^3.2.0"
	}
}
