{
	"type": "module",
	"name": "@atcute/lex-cli",
	"version": "2.3.0",
	"description": "cli tool to generate type definitions for atcute",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lex-cli"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts",
		"cli.mjs",
		"schema/"
	],
	"bin": "./cli.mjs",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "pnpm run generate:schema && tsc",
		"generate:schema": "node scripts/generate-schema.ts",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/lexicon-doc": "workspace:^",
		"@badrap/valita": "^0.4.6",
		"@optique/core": "^0.6.1",
		"@optique/run": "^0.6.1",
		"picocolors": "^1.1.1",
		"prettier": "^3.6.2",
		"valibot": "^1.0.0"
	},
	"devDependencies": {
		"@atcute/lexicons": "workspace:^",
		"@types/node": "^22.18.0",
		"@valibot/to-json-schema": "^1.3.0"
	}
}
