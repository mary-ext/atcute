{
	"name": "@atcute/lexicon-resolver-node",
	"version": "1.0.0",
	"description": "additional atproto lexicon resolvers for Node.js",
	"keywords": [
		"atproto",
		"did",
		"lexicon"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lexicon-resolver-node"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/identity": "workspace:^",
		"@atcute/lexicon-resolver": "workspace:^",
		"@types/node": "^25.9.4"
	},
	"peerDependencies": {
		"@atcute/identity": "^2.0.0",
		"@atcute/lexicon-resolver": "^1.0.0",
		"@atcute/lexicons": "^2.0.0"
	}
}
