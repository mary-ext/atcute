{
	"name": "@atcute/lexicon-doc",
	"version": "2.1.1",
	"description": "type definitions and schemas for atproto lexicon documents",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lexicon-doc"
	},
	"files": [
		"dist/",
		"lib/",
		"schema/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./lib/index.ts",
		"./builder": "./lib/builder.ts",
		"./validations": "./lib/validations.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./builder": "./dist/builder.js",
			"./validations": "./dist/validations.js"
		}
	},
	"scripts": {
		"build": "pnpm run generate:schema && tsgo --project tsconfig.build.json",
		"generate:schema": "node scripts/generate-schema.js",
		"test": "vitest --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/identity": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/uint8array": "workspace:^",
		"@atcute/util-text": "workspace:^",
		"@badrap/valita": "^0.4.6"
	},
	"devDependencies": {
		"@valibot/to-json-schema": "^1.5.0",
		"@vitest/coverage-v8": "^4.0.18",
		"tschema": "^3.2.0",
		"valibot": "^1.2.0",
		"vitest": "^4.0.18"
	}
}
