{
	"type": "module",
	"name": "@atcute/lexicon-doc",
	"version": "1.1.3",
	"description": "type definitions and schemas for atproto lexicon documents",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lexicon-doc"
	},
	"files": [
		"dist/",
		"schema/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "pnpm run generate:schema && tsc --project tsconfig.build.json",
		"generate:schema": "node scripts/generate-schema.js",
		"test": "vitest --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@badrap/valita": "^0.4.6"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^3.2.4",
		"tschema": "^3.2.0",
		"vitest": "^3.2.4"
	}
}
