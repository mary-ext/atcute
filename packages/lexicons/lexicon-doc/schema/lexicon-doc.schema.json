      "type": "object",
      "properties": {
        "type": {
          "const": "string"
        },
        "format": {
          "enum": [
            "datetime",
            "uri",
            "at-uri",
            "did",
            "handle",
            "at-identifier",
            "nsid",
            "cid",
            "language",
            "tid",
            "record-key"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "minLength": {
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "minimum": 0,
          "type": "integer"
        },
        "minGraphemes": {
          "minimum": 0,
          "type": "integer"
        },
        "maxGraphemes": {
          "minimum": 0,
          "type": "integer"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "const": {
          "type": "string"
        },
        "knownValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexStringFormat": {
      "enum": [
        "datetime",
        "uri",
        "at-uri",
        "did",
        "handle",
        "at-identifier",
        "nsid",
        "cid",
        "language",
        "tid",
        "record-key"
      ]
    },
    "LexToken": {
      "type": "object",
      "properties": {
        "type": {
          "const": "token"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexUnknown": {
      "type": "object",
      "properties": {
        "type": {
          "const": "unknown"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexUserType": {
      "anyOf": [
        {
          "$ref": "#/$defs/LexRecord"
        },
        {
          "$ref": "#/$defs/LexXrpcQuery"
        },
        {
          "$ref": "#/$defs/LexXrpcProcedure"
        },
        {
          "$ref": "#/$defs/LexXrpcSubscription"
        },
        {
          "$ref": "#/$defs/LexObject"
        },
        {
          "$ref": "#/$defs/LexArray"
        },
        {
          "$ref": "#/$defs/LexToken"
        },
        {
          "$ref": "#/$defs/LexIpldType"
        },
        {
          "$ref": "#/$defs/LexBlob"
        },
        {
          "$ref": "#/$defs/LexPrimitive"
        }
      ]
    },
    "LexXrpcBody": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "encoding": {
          "pattern": "^\\s*(?:\\*\\/\\*|[a-z]+\\/[a-zA-Z][a-zA-Z0-9-+.]*)(?:\\s*,\\s*(?:\\*\\/\\*|[a-z]+\\/[a-zA-Z][a-zA-Z0-9-+.]*))*\\s*$",
          "type": "string"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/LexRefVariant"
            },
            {
              "$ref": "#/$defs/LexObject"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "encoding"
      ]
    },
    "LexXrpcError": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "LexXrpcParameters": {
      "type": "object",
      "properties": {
        "type": {
          "const": "params"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
            "type": "string"
          }
        },
        "properties": {
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
            "type": "string"
          },
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/LexPrimitive"
              },
              {
                "$ref": "#/$defs/LexPrimitiveArray"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
