            "type": "string"
          }
        },
        "closed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "refs"
      ]
    },
    "LexRefVariant": {
      "anyOf": [
        {
          "$ref": "#/$defs/LexRef"
