      "type": "object",
      "properties": {
        "type": {
          "const": "procedure"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "const": "params"
            },
            "description": {
              "type": "string"
            },
            "required": {
              "type": "array",
              "items": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
                "type": "string"
              }
            },
            "properties": {
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
                "type": "string"
              },
              "type": "object",
              "additionalProperties": {
