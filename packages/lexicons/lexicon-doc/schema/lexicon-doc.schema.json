{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/@atcute/lexicon-doc/schema/lexicon-doc.schema.json",
  "title": "",
  "description": "",
  "type": "object",
  "properties": {
    "lexicon": {
      "const": 1
    },
    "id": {
      "pattern": "^[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+(?:\\.[a-zA-Z](?:[a-zA-Z0-9]{0,62})?)$",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "defs": {
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/LexObject"
          },
          {
            "$ref": "#/$defs/LexArray"
          },
          {
            "$ref": "#/$defs/LexToken"
          },
          {
            "$ref": "#/$defs/LexIpldType"
          },
          {
            "$ref": "#/$defs/LexBlob"
          },
          {
            "$ref": "#/$defs/LexPrimitive"
          }
        ]
      },
      "type": "object",
      "properties": {
        "main": {
          "anyOf": [
            {
              "$ref": "#/$defs/LexRecord"
            },
            {
              "$ref": "#/$defs/LexXrpcQuery"
            },
            {
              "$ref": "#/$defs/LexXrpcProcedure"
            },
            {
              "$ref": "#/$defs/LexXrpcSubscription"
            },
            {
              "$ref": "#/$defs/LexObject"
            },
            {
              "$ref": "#/$defs/LexArray"
            },
            {
              "$ref": "#/$defs/LexToken"
            },
            {
              "$ref": "#/$defs/LexIpldType"
            },
            {
              "$ref": "#/$defs/LexBlob"
            },
            {
              "$ref": "#/$defs/LexPrimitive"
            }
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "lexicon",
    "id",
    "defs"
  ],
  "$defs": {
    "LexArray": {
      "type": "object",
      "properties": {
        "type": {
          "const": "array"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/LexPrimitive"
            },
            {
              "$ref": "#/$defs/LexIpldType"
            },
            {
              "$ref": "#/$defs/LexRefVariant"
            },
            {
              "$ref": "#/$defs/LexBlob"
            }
          ]
        },
        "minLength": {
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ]
    },
    "LexBlob": {
      "type": "object",
      "properties": {
        "type": {
          "const": "blob"
        },
        "description": {
          "type": "string"
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxSize": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexBoolean": {
      "type": "object",
      "properties": {
        "type": {
          "const": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "const": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexBytes": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bytes"
        },
        "description": {
          "type": "string"
        },
        "minLength": {
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexCidLink": {
      "type": "object",
      "properties": {
        "type": {
          "const": "cid-link"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexInteger": {
      "type": "object",
      "properties": {
        "type": {
          "const": "integer"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "minimum": 0,
          "type": "integer"
        },
        "enum": {
          "type": "array",
          "items": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "const": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "LexIpldType": {
      "anyOf": [
        {
          "$ref": "#/$defs/LexBytes"
        },
        {
          "$ref": "#/$defs/LexCidLink"
        }
      ]
    },
    "LexObject": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "items": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
            "type": "string"
          }
        },
        "nullable": {
          "type": "array",
          "items": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
            "type": "string"
          }
        },
        "properties": {
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
            "type": "string"
          },
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/LexArray"
              },
              {
                "$ref": "#/$defs/LexPrimitive"
              },
              {
                "$ref": "#/$defs/LexIpldType"
              },
              {
                "$ref": "#/$defs/LexRefVariant"
              },
              {
                "$ref": "#/$defs/LexBlob"
              }
            ]
          }
        }
