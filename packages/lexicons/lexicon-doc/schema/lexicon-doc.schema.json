              "type": "array",
              "items": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
                "type": "string"
              }
            },
            "properties": {
              "propertyNames": {
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}?$",
                "type": "string"
              },
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LexPrimitive"
                  },
