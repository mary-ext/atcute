        },
        {
          "$ref": "#/$defs/LexUnknown"
        }
      ]
    },
    "LexPrimitiveArray": {
      "type": "object",
      "properties": {
        "type": {
          "const": "array"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/LexPrimitive"
        },
        "minLength": {
          "minimum": 0,
          "type": "integer"
        },
        "maxLength": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ]
    },
    "LexRecord": {
      "type": "object",
      "properties": {
        "type": {
          "const": "record"
        },
        "description": {
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "enum": [
                "tid",
                "nsid",
                "any"
              ]
            },
            {
              "pattern": "^literal:.+$",
              "type": "string"
            }
          ]
        },
        "record": {
          "$ref": "#/$defs/LexObject"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "record"
      ]
    },
    "LexRef": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ref"
        },
        "description": {
          "type": "string"
        },
        "ref": {
          "pattern": "^(?=.)(?:[a-zA-Z](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+\\.[a-zA-Z][a-zA-Z0-9]{0,62}?)?(?:#[a-zA-Z][a-zA-Z0-9_]{0,62}?)?$",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ]
    },
    "LexRefUnion": {
      "type": "object",
      "properties": {
        "type": {
          "const": "union"
        },
        "description": {
          "type": "string"
