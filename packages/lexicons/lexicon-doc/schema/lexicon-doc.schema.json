                },
                {
                  "$ref": "#/$defs/LexObject"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "encoding"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "encoding": {
              "pattern": "^\\s*(?:\\*\\/\\*|[a-z]+\\/[a-zA-Z][a-zA-Z0-9-+.]*)(?:\\s*,\\s*(?:\\*\\/\\*|[a-z]+\\/[a-zA-Z][a-zA-Z0-9-+.]*))*\\s*$",
              "type": "string"
            },
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LexRefVariant"
                },
                {
                  "$ref": "#/$defs/LexObject"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "encoding"
          ]
        },
        "errors": {
          "type": "array",
