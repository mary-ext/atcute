{
	"type": "module",
	"name": "@atcute/lexicons",
	"version": "1.2.6",
	"description": "AT Protocol core lexicon types and schema validations",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lexicons"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./ambient": "./dist/ambient.js",
		"./interfaces": "./dist/interfaces/index.js",
		"./syntax": "./dist/syntax/index.js",
		"./validations": "./dist/validations/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"devDependencies": {
		"@atcute/cbor": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@vitest/coverage-v8": "^4.0.16",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"@atcute/uint8array": "workspace:^",
		"@atcute/util-text": "workspace:^",
		"@standard-schema/spec": "^1.1.0",
		"esm-env": "^1.2.2"
	}
}
