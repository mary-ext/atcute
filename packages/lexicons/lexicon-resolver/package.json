{
	"name": "@atcute/lexicon-resolver",
	"version": "0.1.7",
	"description": "atproto lexicon authority resolution",
	"keywords": [
		"atproto",
		"did",
		"lexicon"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/lexicons/lexicon-resolver"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/crypto": "workspace:^",
		"@atcute/lexicon-doc": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/repo": "workspace:^",
		"@atcute/util-fetch": "workspace:^",
		"valibot": "^1.4.0"
	},
	"devDependencies": {
		"@atcute/identity": "workspace:^",
		"@atcute/identity-resolver": "workspace:^",
		"@vitest/coverage-v8": "^4.1.5",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@atcute/identity": "^1.1.0",
		"@atcute/identity-resolver": "^1.1.3",
		"@atcute/lexicon-doc": "^2.0.0",
		"@atcute/lexicons": "^1.0.0"
	}
}
