{
	"id": "blog.pckt.block.listItem",
	"defs": {
		"main": {
			"type": "object",
			"required": ["content"],
			"properties": {
				"content": {
					"type": "array",
					"items": {
						"refs": [
							"blog.pckt.block.paragraph",
							"blog.pckt.block.bulletList",
							"blog.pckt.block.orderedList"
						],
						"type": "union",
						"closed": false
					},
					"description": "Array of block content (paragraphs or nested lists)"
				}
			}
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"description": "List item within ordered or unordered lists. Can contain paragraphs and nested lists."
}
