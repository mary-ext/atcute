{
	"id": "blog.pckt.block.taskItem",
	"defs": {
		"main": {
			"type": "object",
			"required": ["attrs", "content"],
			"properties": {
				"attrs": {
					"ref": "#taskItemAttrs",
					"type": "ref",
					"description": "Task item attributes"
				},
				"content": {
					"type": "array",
					"items": {
						"refs": ["blog.pckt.block.paragraph"],
						"type": "union",
						"closed": false
					},
					"description": "Array of paragraph content"
				}
			}
		},
		"taskItemAttrs": {
			"type": "object",
			"required": ["checked"],
			"properties": {
				"checked": {
					"type": "boolean",
					"description": "Whether the task is checked or unchecked"
				}
			},
			"description": "Task item attributes"
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"description": "Individual task item with checkbox state. Contains rich text content that describes the task."
}
