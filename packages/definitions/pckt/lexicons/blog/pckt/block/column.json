{
	"id": "blog.pckt.block.column",
	"defs": {
		"main": {
			"type": "object",
			"required": ["content"],
			"properties": {
				"content": {
					"type": "array",
					"items": {
						"refs": [
							"blog.pckt.block.blockquote",
							"blog.pckt.block.bulletList",
							"blog.pckt.block.codeBlock",
							"blog.pckt.block.heading",
							"blog.pckt.block.horizontalRule",
							"blog.pckt.block.image",
							"blog.pckt.block.orderedList",
							"blog.pckt.block.taskList",
							"blog.pckt.block.text"
						],
						"type": "union",
						"closed": false
					},
					"description": "Array of content blocks, top to bottom"
				}
			}
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"description": "One side of a two-column layout. Holds ordinary content blocks."
}
