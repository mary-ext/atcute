{
	"id": "blog.pckt.block.blockquote",
	"defs": {
		"main": {
			"type": "object",
			"required": ["content"],
			"properties": {
				"content": {
					"type": "array",
					"items": {
						"refs": ["blog.pckt.block.paragraph"],
						"type": "union",
						"closed": false
					},
					"description": "Array of paragraph content"
				}
			}
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"description": "Blockquote for quoted text or citations. Typically rendered with distinct visual styling to set quoted content apart from the main text."
}
