{
	"id": "blog.pckt.theme",
	"defs": {
		"main": {
			"type": "object",
			"required": ["dark", "light"],
			"properties": {
				"dark": {
					"ref": "#palette",
					"type": "ref",
					"description": "Dark mode color palette"
				},
				"font": {
					"type": "string",
					"maxLength": 100,
					"description": "Font family name (optional)"
				},
				"light": {
					"ref": "#palette",
					"type": "ref",
					"description": "Light mode color palette"
				},
				"corners": {
					"type": "string",
					"maxLength": 16,
					"description": "Corner style for UI elements and images: rounded or square (optional)",
					"knownValues": ["round", "square"]
				},
				"wordmark": {
					"ref": "#image",
					"type": "ref",
					"description": "Wide logo shown in the publication header in place of the icon and name (optional)"
				},
				"transparency": {
					"type": "integer",
					"maximum": 100,
					"minimum": 0,
					"description": "Content background transparency percentage (optional)"
				},
				"wordmarkDark": {
					"ref": "#image",
					"type": "ref",
					"description": "Version of the wordmark to show in dark mode (optional)"
				},
				"highlightColor": {
					"type": "string",
					"maxLength": 16,
					"description": "Highlight color for quoted passages (optional)",
					"knownValues": ["theme", "yellow"]
				},
				"highlightShape": {
					"type": "string",
					"maxLength": 32,
					"description": "Highlight shape for quoted passages (optional)",
					"knownValues": ["chisel", "felt", "loose", "round", "scratchy", "square"]
				},
				"tileBackground": {
					"type": "boolean",
					"description": "Whether to tile the background image instead of covering (optional)"
				},
				"backgroundImage": {
					"ref": "#image",
					"type": "ref",
					"description": "Image drawn behind the publication's pages (optional)"
				},
				"backgroundTileSize": {
					"type": "integer",
					"maximum": 100,
					"minimum": 5,
					"description": "Background tile size as a percentage when tileBackground is true (optional)"
				}
			},
			"description": "Theme configuration for a blog publication"
		},
		"image": {
			"type": "object",
			"required": ["image"],
			"properties": {
				"image": {
					"type": "blob",
					"accept": ["image/*"],
					"maxSize": 5000000,
					"description": "The image file"
				},
				"aspectRatio": {
					"ref": "#aspectRatio",
					"type": "ref",
					"description": "Pixel dimensions of the image, for laying it out before it loads (optional)"
				}
			},
			"description": "An image with the shape it was uploaded in"
		},
		"palette": {
			"type": "object",
			"required": ["accent", "background", "link", "surfaceHover", "text"],
			"properties": {
				"link": {
					"type": "string",
					"maxLength": 7,
					"description": "Link color (hex value)"
				},
				"text": {
					"type": "string",
					"maxLength": 7,
					"description": "Primary text color (hex value)"
				},
				"accent": {
					"type": "string",
					"maxLength": 7,
					"description": "Accent color (hex value)"
				},
				"background": {
					"type": "string",
					"maxLength": 7,
					"description": "Background color (hex value)"
				},
				"surfaceHover": {
					"type": "string",
					"maxLength": 7,
					"description": "Surface hover color (hex value)"
				}
			},
			"description": "Color palette with CSS hex values"
		},
		"aspectRatio": {
			"type": "object",
			"required": ["height", "width"],
			"properties": {
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				}
			},
			"description": "Width and height of an image, in pixels or any unit that keeps their ratio"
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1,
	"description": "Theme record for blog publications with light and dark mode color schemes."
}
