{
	"id": "tools.ozone.queue.updateQueue",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["queueId"],
					"properties": {
						"name": {
							"type": "string",
							"description": "New display name for the queue"
						},
						"enabled": {
							"type": "boolean",
							"description": "Enable or disable the queue"
						},
						"queueId": {
							"type": "integer",
							"description": "ID of the queue to update"
						},
						"description": {
							"type": "string",
							"description": "Optional description of the queue"
						},
						"recommendedPolicies": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"description": "Policy keys to recommend when actioning reports in this queue"
						}
					}
				},
				"encoding": "application/json"
			},
			"errors": [
				{
					"name": "InvalidRecommendedPolicies",
					"description": "One or more recommended policy keys do not exist in the configured policy list"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["queue"],
					"properties": {
						"queue": {
							"ref": "tools.ozone.queue.defs#queueView",
							"type": "ref"
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Update queue properties."
		}
	},
	"lexicon": 1
}
