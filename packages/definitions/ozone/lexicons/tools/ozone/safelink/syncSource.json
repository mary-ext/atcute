{
	"id": "tools.ozone.safelink.syncSource",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["rules", "source"],
					"properties": {
						"rules": {
							"type": "array",
							"items": {
								"ref": "#sourceRule",
								"type": "ref"
							}
						},
						"source": {
							"type": "string",
							"maxLength": 128,
							"description": "Source whose rules are being synchronized"
						}
					}
				},
				"encoding": "application/json"
			},
			"output": {
				"schema": {
					"type": "object",
					"required": ["added", "events", "removed", "updated"],
					"properties": {
						"added": {
							"type": "integer"
						},
						"events": {
							"type": "integer"
						},
						"removed": {
							"type": "integer"
						},
						"updated": {
							"type": "integer"
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Replace stored rules for one source from a complete snapshot. Existing rules owned by another source remain unchanged."
		},
		"sourceRule": {
			"type": "object",
			"required": ["action", "pattern", "reason", "url"],
			"properties": {
				"url": {
					"type": "string"
				},
				"action": {
					"ref": "tools.ozone.safelink.defs#actionType",
					"type": "ref"
				},
				"reason": {
					"ref": "tools.ozone.safelink.defs#reasonType",
					"type": "ref"
				},
				"pattern": {
					"ref": "tools.ozone.safelink.defs#patternType",
					"type": "ref"
				}
			}
		}
	},
	"lexicon": 1
}
