{
	"id": "tools.ozone.report.getAssignments",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["assignments"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"assignments": {
							"type": "array",
							"items": {
								"ref": "tools.ozone.report.defs#assignmentView",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"properties": {
					"dids": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "did"
						},
						"maxLength": 50,
						"description": "If specified, returns assignments for these moderators only."
					},
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 100,
						"minimum": 1
					},
					"cursor": {
						"type": "string"
					},
					"reportIds": {
						"type": "array",
						"items": {
							"type": "integer"
						},
						"maxLength": 50,
						"description": "If specified, returns assignments for these reports only."
					},
					"onlyActive": {
						"type": "boolean",
						"default": true,
						"description": "When true, only returns active assignments."
					}
				}
			},
			"description": "Get assignments for reports."
		}
	},
	"lexicon": 1
}
