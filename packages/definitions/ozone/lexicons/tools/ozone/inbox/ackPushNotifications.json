{
	"id": "tools.ozone.inbox.ackPushNotifications",
	"defs": {
		"item": {
			"type": "object",
			"required": ["id", "leaseToken"],
			"properties": {
				"id": {
					"type": "integer"
				},
				"leaseToken": {
					"type": "string",
					"maxLength": 64
				}
			}
		},
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["items"],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#item",
								"type": "ref"
							},
							"maxLength": 100,
							"minLength": 1
						}
					}
				},
				"encoding": "application/json"
			},
			"output": {
				"schema": {
					"type": "object",
					"required": ["acknowledged"],
					"properties": {
						"acknowledged": {
							"type": "array",
							"items": {
								"type": "integer"
							}
						}
					}
				},
				"encoding": "application/json"
			}
		}
	},
	"lexicon": 1
}
