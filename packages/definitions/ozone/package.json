{
	"name": "@atcute/ozone",
	"version": "3.1.13",
	"description": "Ozone (tools.ozone.*) scheam definitions",
	"keywords": [
		"atcute",
		"atproto",
		"bluesky",
		"ozone"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/ozone"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./lib/index.ts",
		"./types/": "./lib/lexicons/types/tools/ozone/*.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./types/": "./dist/lexicons/types/tools/ozone/*.js"
		}
	},
	"scripts": {
		"build": "tsgo",
		"pull": "lex-cli pull",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/ozone": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"tools.ozone.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
