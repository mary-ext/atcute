{
	"type": "module",
	"name": "@atcute/ozone",
	"version": "3.1.9",
	"description": "Ozone (tools.ozone.*) scheam definitions",
	"keywords": [
		"atcute",
		"atproto",
		"bluesky",
		"ozone"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/ozone"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./types/": "./dist/lexicons/types/tools/ozone/*.js"
	},
	"scripts": {
		"build": "tsc",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate -c ./lex.config.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/ozone": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"tools.ozone.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
