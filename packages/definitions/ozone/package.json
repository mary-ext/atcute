{
	"name": "@atcute/ozone",
	"version": "4.0.7",
	"description": "Ozone (tools.ozone.*) scheam definitions",
	"keywords": [
		"atcute",
		"atproto",
		"bluesky",
		"ozone"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/ozone"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./types/": "./dist/lexicons/types/tools/ozone/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"pull": "lex-cli pull",
		"generate": "lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/ozone": "file:"
	},
	"peerDependencies": {
		"@atcute/lexicons": "^2.0.0"
	},
	"atcute:lexicons": {
		"mappings": {
			"tools.ozone.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
