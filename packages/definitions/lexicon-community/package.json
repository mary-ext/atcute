{
	"name": "@atcute/lexicon-community",
	"version": "1.1.4",
	"description": "Lexicon Community (community.lexicon.*) schema definitions",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/lexicon-community"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./lib/index.ts",
		"./types/": "./lib/lexicons/types/community/lexicon/*.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./types/": "./dist/lexicons/types/community/lexicon/*.js"
		}
	},
	"scripts": {
		"build": "tsgo",
		"pull": "lex-cli pull",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/lexicon-community": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"community.lexicon.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
