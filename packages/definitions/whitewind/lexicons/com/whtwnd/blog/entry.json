{
	"id": "com.whtwnd.blog.entry",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["content"],
				"properties": {
					"ogp": {
						"ref": "com.whtwnd.blog.defs#ogp",
						"type": "ref"
					},
					"blobs": {
						"type": "array",
						"items": {
							"ref": "com.whtwnd.blog.defs#blobMetadata",
							"type": "ref"
						}
					},
					"theme": {
						"enum": ["github-light"],
						"type": "string"
					},
					"title": {
						"type": "string",
						"maxLength": 1000
					},
					"content": {
						"type": "string",
						"maxLength": 100000
					},
					"isDraft": {
						"type": "boolean",
						"description": "(DEPRECATED) Marks this entry as draft to tell AppViews not to show it to anyone except for the author"
					},
					"subtitle": {
						"type": "string",
						"maxLength": 1000
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"visibility": {
						"enum": ["public", "url", "author"],
						"type": "string",
						"default": "public",
						"description": "Tells the visibility of the article to AppView."
					}
				}
			},
			"description": "A declaration of a post."
		}
	},
	"lexicon": 1
}
