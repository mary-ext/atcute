{
	"id": "com.whtwnd.blog.defs",
	"defs": {
		"ogp": {
			"type": "object",
			"required": ["url"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				},
				"width": {
					"type": "integer"
				},
				"height": {
					"type": "integer"
				}
			}
		},
		"comment": {
			"type": "object",
			"required": ["content", "entryUri"],
			"properties": {
				"content": {
					"type": "string",
					"maxLength": 1000
				},
				"entryUri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		},
		"blogEntry": {
			"type": "object",
			"required": ["content"],
			"properties": {
				"content": {
					"type": "string",
					"maxLength": 100000
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				}
			}
		},
		"blobMetadata": {
			"type": "object",
			"required": ["blobref"],
			"properties": {
				"name": {
					"type": "string"
				},
				"blobref": {
					"type": "blob",
					"accept": ["*/*"]
				}
			}
		}
	},
	"lexicon": 1
}
