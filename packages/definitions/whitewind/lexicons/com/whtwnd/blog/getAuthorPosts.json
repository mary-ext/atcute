{
	"id": "com.whtwnd.blog.getAuthorPosts",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["post"],
					"properties": {
						"post": {
							"type": "array",
							"items": {
								"ref": "com.whtwnd.blog.defs#blogEntry",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["author"],
				"properties": {
					"author": {
						"type": "string",
						"format": "did"
					}
				}
			},
			"description": "Get blog posts associated to designated author."
		}
	},
	"lexicon": 1
}
