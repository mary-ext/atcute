{
	"type": "module",
	"name": "@atcute/whitewind",
	"version": "3.1.3",
	"description": "WhiteWind (com.whtwnd.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"whitewind"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/whitewind"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/com/whtwnd/*.js"
	},
	"scripts": {
		"build": "tsc",
		"pull": "lex-cli pull -c ./lex.config.js",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate -c ./lex.config.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/whitewind": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"com.whtwnd.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
