{
	"name": "@atcute/leaflet",
	"version": "2.0.12",
	"description": "Leaflet (pub.leaflet.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"leaflet"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://tangled.org/did:plc:pljn5qch4tgadongtc7i6qij",
		"directory": "packages/definitions/leaflet"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/pub/leaflet/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"pull": "lex-cli pull",
		"generate": "lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/leaflet": "file:",
		"@atcute/lex-cli": "workspace:^"
	},
	"peerDependencies": {
		"@atcute/lexicons": "^2.0.0"
	},
	"atcute:lexicons": {
		"mappings": {
			"pub.leaflet.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
