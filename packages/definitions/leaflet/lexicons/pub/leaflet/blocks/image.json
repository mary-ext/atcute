{
	"id": "pub.leaflet.blocks.image",
	"defs": {
		"main": {
			"type": "object",
			"required": ["aspectRatio", "image"],
			"properties": {
				"alt": {
					"type": "string",
					"description": "Alt text description of the image, for accessibility."
				},
				"image": {
					"type": "blob",
					"accept": ["image/*"],
					"maxSize": 1000000
				},
				"fullBleed": {
					"type": "boolean",
					"description": "Whether the image should extend to the full width of the container, ignoring padding."
				},
				"aspectRatio": {
					"ref": "#aspectRatio",
					"type": "ref"
				}
			}
		},
		"aspectRatio": {
			"type": "object",
			"required": ["height", "width"],
			"properties": {
				"width": {
					"type": "integer"
				},
				"height": {
					"type": "integer"
				}
			}
		}
	},
	"lexicon": 1
}
