{
	"id": "pub.leaflet.theme.wordmark",
	"defs": {
		"main": {
			"type": "object",
			"required": ["image"],
			"properties": {
				"image": {
					"type": "blob",
					"accept": ["image/*"],
					"maxSize": 1000000
				},
				"width": {
					"type": "integer"
				},
				"aspectRatio": {
					"ref": "#aspectRatio",
					"type": "ref"
				}
			}
		},
		"aspectRatio": {
			"type": "object",
			"required": ["height", "width"],
			"properties": {
				"width": {
					"type": "integer"
				},
				"height": {
					"type": "integer"
				}
			}
		}
	},
	"lexicon": 1
}
