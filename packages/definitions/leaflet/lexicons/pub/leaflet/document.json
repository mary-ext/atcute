{
	"id": "pub.leaflet.document",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["pages", "author", "title"],
				"properties": {
					"tags": {
						"type": "array",
						"items": {
							"type": "string",
							"maxLength": 50
						}
					},
					"pages": {
						"type": "array",
						"items": {
							"refs": ["pub.leaflet.pages.linearDocument", "pub.leaflet.pages.canvas"],
							"type": "union"
						}
					},
					"theme": {
						"ref": "pub.leaflet.publication#theme",
						"type": "ref"
					},
					"title": {
						"type": "string",
						"maxLength": 5000,
						"maxGraphemes": 500
					},
					"author": {
						"type": "string",
						"format": "at-identifier"
					},
					"postRef": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref"
					},
					"coverImage": {
						"type": "blob",
						"accept": ["image/png", "image/jpeg", "image/webp"],
						"maxSize": 1000000
					},
					"description": {
						"type": "string",
						"maxLength": 30000,
						"maxGraphemes": 3000
					},
					"preferences": {
						"ref": "pub.leaflet.publication#preferences",
						"type": "ref"
					},
					"publication": {
						"type": "string",
						"format": "at-uri"
					},
					"publishedAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			},
			"description": "Record containing a document"
		}
	},
	"lexicon": 1,
	"revision": 1,
	"description": "A lexicon for long form rich media documents"
}
