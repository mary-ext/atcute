{
	"id": "chat.bsky.moderation.getActorMetadata",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["all", "day", "month"],
					"properties": {
						"all": {
							"ref": "#metadata",
							"type": "ref"
						},
						"day": {
							"ref": "#metadata",
							"type": "ref"
						},
						"month": {
							"ref": "#metadata",
							"type": "ref"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["actor"],
				"properties": {
					"actor": {
						"type": "string",
						"format": "did"
					}
				}
			}
		},
		"metadata": {
			"type": "object",
			"required": ["convos", "convosStarted", "messagesReceived", "messagesSent"],
			"properties": {
				"convos": {
					"type": "integer"
				},
				"messagesSent": {
					"type": "integer"
				},
				"convosStarted": {
					"type": "integer"
				},
				"messagesReceived": {
					"type": "integer"
				}
			}
		}
	},
	"lexicon": 1
}
