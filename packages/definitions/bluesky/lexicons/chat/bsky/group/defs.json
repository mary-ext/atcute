{
	"id": "chat.bsky.group.defs",
	"defs": {
		"joinRule": {
			"type": "string",
			"knownValues": ["anyone", "followedByOwner"]
		},
		"joinLinkView": {
			"type": "object",
			"required": ["code", "createdAt", "enabledStatus", "joinRule", "requireApproval"],
			"properties": {
				"code": {
					"type": "string"
				},
				"joinRule": {
					"ref": "#joinRule",
					"type": "ref"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"enabledStatus": {
					"ref": "#linkEnabledStatus",
					"type": "ref"
				},
				"requireApproval": {
					"type": "boolean"
				}
			}
		},
		"joinRequestView": {
			"type": "object",
			"required": ["convoId", "requestedAt", "requestedBy"],
			"properties": {
				"convoId": {
					"type": "string"
				},
				"requestedAt": {
					"type": "string",
					"format": "datetime"
				},
				"requestedBy": {
					"ref": "chat.bsky.actor.defs#profileViewBasic",
					"type": "ref"
				}
			}
		},
		"linkEnabledStatus": {
			"type": "string",
			"knownValues": ["disabled", "enabled"]
		},
		"joinLinkPreviewView": {
			"type": "object",
			"required": [
				"code",
				"enabledStatus",
				"joinRule",
				"memberCount",
				"memberLimit",
				"name",
				"owner",
				"requireApproval"
			],
			"properties": {
				"code": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"convo": {
					"ref": "chat.bsky.convo.defs#convoView",
					"type": "ref",
					"description": "Present only if the request is authenticated and the user is a member of the group."
				},
				"owner": {
					"ref": "chat.bsky.actor.defs#profileViewBasic",
					"type": "ref"
				},
				"viewer": {
					"ref": "#joinLinkViewerState",
					"type": "ref"
				},
				"joinRule": {
					"ref": "#joinRule",
					"type": "ref"
				},
				"memberCount": {
					"type": "integer"
				},
				"memberLimit": {
					"type": "integer"
				},
				"enabledStatus": {
					"ref": "#linkEnabledStatus",
					"type": "ref"
				},
				"requireApproval": {
					"type": "boolean"
				}
			}
		},
		"joinLinkViewerState": {
			"type": "object",
			"properties": {
				"requestedAt": {
					"type": "string",
					"format": "datetime"
				}
			}
		},
		"joinRequestConvoView": {
			"type": "object",
			"required": ["convoId", "memberCount", "memberLimit", "name", "owner", "requestedAt"],
			"properties": {
				"name": {
					"type": "string"
				},
				"owner": {
					"ref": "chat.bsky.actor.defs#profileViewBasic",
					"type": "ref"
				},
				"convoId": {
					"type": "string"
				},
				"memberCount": {
					"type": "integer"
				},
				"memberLimit": {
					"type": "integer"
				},
				"requestedAt": {
					"type": "string",
					"format": "datetime"
				}
			},
			"description": "A join request from the perspective of the requester, including enough group context to render the request in a list (e.g. group name, owner, member count)."
		}
	},
	"lexicon": 1,
	"description": "[NOTE: This is under active development and should be considered unstable while this note is here]."
}
