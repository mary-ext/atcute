{
	"id": "app.bsky.unspecced.getTaggedSuggestions",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["suggestions"],
					"properties": {
						"suggestions": {
							"type": "array",
							"items": {
								"ref": "#suggestion",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"properties": {}
			},
			"description": "Get a list of suggestions (feeds and users) tagged with categories"
		},
		"suggestion": {
			"type": "object",
			"required": ["tag", "subjectType", "subject"],
			"properties": {
				"tag": {
					"type": "string"
				},
				"subject": {
					"type": "string",
					"format": "uri"
				},
				"subjectType": {
					"type": "string",
					"knownValues": ["actor", "feed"]
				}
			}
		}
	},
	"lexicon": 1
}
