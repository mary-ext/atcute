{
	"id": "app.bsky.unspecced.getTrends",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["trends"],
					"properties": {
						"trends": {
							"type": "array",
							"items": {
								"ref": "app.bsky.unspecced.defs#trendView",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"properties": {
					"limit": {
						"type": "integer",
						"default": 10,
						"maximum": 25,
						"minimum": 1
					}
				}
			},
			"description": "Get the current trends on the network"
		}
	},
	"lexicon": 1
}
