{
	"id": "app.bsky.unspecced.defs",
	"defs": {
		"trendView": {
			"type": "object",
			"required": ["actors", "displayName", "link", "postCount", "startedAt", "topic"],
			"properties": {
				"link": {
					"type": "string"
				},
				"topic": {
					"type": "string"
				},
				"actors": {
					"type": "array",
					"items": {
						"ref": "app.bsky.actor.defs#profileViewBasic",
						"type": "ref"
					}
				},
				"status": {
					"type": "string",
					"knownValues": ["hot"]
				},
				"category": {
					"type": "string"
				},
				"postCount": {
					"type": "integer"
				},
				"startedAt": {
					"type": "string",
					"format": "datetime"
				},
				"description": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				}
			}
		},
		"skeletonTrend": {
			"type": "object",
			"required": ["dids", "displayName", "link", "postCount", "startedAt", "topic"],
			"properties": {
				"dids": {
					"type": "array",
					"items": {
						"type": "string",
						"format": "did"
					}
				},
				"link": {
					"type": "string"
				},
				"topic": {
					"type": "string"
				},
				"status": {
					"type": "string",
					"knownValues": ["hot"]
				},
				"category": {
					"type": "string"
				},
				"postCount": {
					"type": "integer"
				},
				"startedAt": {
					"type": "string",
					"format": "datetime"
				},
				"description": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				}
			}
		},
		"trendingTopic": {
			"type": "object",
			"required": ["link", "topic"],
			"properties": {
				"link": {
					"type": "string"
				},
				"topic": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"displayName": {
					"type": "string"
				}
			}
		},
		"threadItemPost": {
			"type": "object",
			"required": ["hiddenByThreadgate", "moreParents", "moreReplies", "mutedByViewer", "opThread", "post"],
			"properties": {
				"post": {
					"ref": "app.bsky.feed.defs#postView",
					"type": "ref"
				},
				"opThread": {
					"type": "boolean",
					"description": "This post is part of a contiguous thread by the OP from the thread root. Many different OP threads can happen in the same thread."
				},
				"moreParents": {
					"type": "boolean",
					"description": "This post has more parents that were not present in the response. This is just a boolean, without the number of parents."
				},
				"moreReplies": {
					"type": "integer",
					"description": "This post has more replies that were not present in the response. This is a numeric value, which is best-effort and might not be accurate."
				},
				"mutedByViewer": {
					"type": "boolean",
					"description": "This is by an account muted by the viewer requesting it."
				},
				"hiddenByThreadgate": {
					"type": "boolean",
					"description": "The threadgate created by the author indicates this post as a reply to be hidden for everyone consuming the thread."
				}
			}
		},
		"ageAssuranceEvent": {
			"type": "object",
			"required": ["attemptId", "createdAt", "status"],
			"properties": {
				"email": {
					"type": "string",
					"description": "The email used for AA."
				},
				"initIp": {
					"type": "string",
					"description": "The IP address used when initiating the AA flow."
				},
				"initUa": {
					"type": "string",
					"description": "The user agent used when initiating the AA flow."
				},
				"status": {
					"type": "string",
					"description": "The status of the age assurance process.",
					"knownValues": ["assured", "pending", "unknown"]
				},
				"attemptId": {
					"type": "string",
					"description": "The unique identifier for this instance of the age assurance flow, in UUID format."
				},
				"createdAt": {
					"type": "string",
					"format": "datetime",
					"description": "The date and time of this write operation."
				},
				"completeIp": {
					"type": "string",
					"description": "The IP address used when completing the AA flow."
				},
				"completeUa": {
					"type": "string",
					"description": "The user agent used when completing the AA flow."
				}
			},
			"description": "Object used to store age assurance data in stash."
		},
		"ageAssuranceState": {
			"type": "object",
			"required": ["status"],
			"properties": {
				"status": {
					"type": "string",
					"description": "The status of the age assurance process.",
					"knownValues": ["assured", "blocked", "pending", "unknown"]
				},
				"lastInitiatedAt": {
					"type": "string",
					"format": "datetime",
					"description": "The timestamp when this state was last updated."
				}
			},
			"description": "The computed state of the age assurance process, returned to the user in question on certain authenticated requests."
		},
		"threadItemBlocked": {
			"type": "object",
			"required": ["author"],
			"properties": {
				"author": {
					"ref": "app.bsky.feed.defs#blockedAuthor",
					"type": "ref"
				}
			}
		},
		"skeletonSearchPost": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		},
		"threadItemNotFound": {
			"type": "object",
			"properties": {}
		},
		"skeletonSearchActor": {
			"type": "object",
			"required": ["did"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did"
				}
			}
		},
		"skeletonSearchStarterPack": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		},
		"threadItemNoUnauthenticated": {
			"type": "object",
			"properties": {}
		}
	},
	"lexicon": 1
}
