{
	"id": "app.bsky.feed.repost",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt", "subject"],
				"properties": {
					"via": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref"
					},
					"subject": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			},
			"description": "Record representing a 'repost' of an existing Bluesky post."
		}
	},
	"lexicon": 1
}
