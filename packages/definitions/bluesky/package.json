{
	"type": "module",
	"name": "@atcute/bluesky",
	"version": "2.1.1",
	"description": "Bluesky (app.bsky.* and chat.bsky.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"bluesky"
	],
	"license": "MIT",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/bluesky"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./types/app/*": "./dist/lexicons/types/app/bsky/*.js",
		"./types/chat/*": "./dist/lexicons/types/chat/bsky/*.js"
	},
	"scripts": {
		"build": "tsc",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate -c ./lex.config.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"peerDependencies": {
		"@atcute/atproto": "^3.0.0",
		"@atcute/lexicons": "^1.0.0"
	},
	"devDependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "file:",
		"@atcute/lex-cli": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	}
}
