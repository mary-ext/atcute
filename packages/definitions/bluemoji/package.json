{
	"type": "module",
	"name": "@atcute/bluemoji",
	"version": "3.1.2",
	"description": "Bluemoji (blue.moji.*) schema definitions",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/bluemoji"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./types/": "./dist/lexicons/types/blue/moji/*.js"
	},
	"scripts": {
		"build": "tsc",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate -c ./lex.config.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/bluemoji": "file:",
		"@atcute/lex-cli": "workspace:^"
	},
	"atcute:lexicons": {
		"mappings": {
			"blue.moji.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
