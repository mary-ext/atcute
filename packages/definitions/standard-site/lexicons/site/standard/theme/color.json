{
	"id": "site.standard.theme.color",
	"defs": {
		"rgb": {
			"type": "object",
			"required": ["b", "g", "r"],
			"properties": {
				"b": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				},
				"g": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				},
				"r": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				}
			}
		},
		"rgba": {
			"type": "object",
			"required": ["a", "b", "g", "r"],
			"properties": {
				"a": {
					"type": "integer",
					"maximum": 100,
					"minimum": 0
				},
				"b": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				},
				"g": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				},
				"r": {
					"type": "integer",
					"maximum": 255,
					"minimum": 0
				}
			}
		}
	},
	"$type": "com.atproto.lexicon.schema",
	"lexicon": 1
}
