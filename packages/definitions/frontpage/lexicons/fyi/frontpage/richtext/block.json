{
	"id": "fyi.frontpage.richtext.block",
	"defs": {
		"main": {
			"type": "object",
			"required": ["content"],
			"properties": {
				"content": {
					"refs": ["#plaintextParagraph"],
					"type": "union"
				}
			}
		},
		"plaintextParagraph": {
			"type": "object",
			"required": ["text"],
			"properties": {
				"text": {
					"type": "string",
					"maxLength": 100000,
					"maxGraphemes": 10000
				}
			}
		}
	},
	"lexicon": 1
}
