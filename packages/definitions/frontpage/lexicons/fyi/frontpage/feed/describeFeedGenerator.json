{
	"id": "fyi.frontpage.feed.describeFeedGenerator",
	"defs": {
		"feed": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		},
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["did", "feeds"],
					"properties": {
						"did": {
							"type": "string",
							"format": "did"
						},
						"feeds": {
							"type": "array",
							"items": {
								"ref": "#feed",
								"type": "ref"
							}
						},
						"links": {
							"ref": "#links",
							"type": "ref"
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Returns information about a feed generator service, including which feeds it provides."
		},
		"links": {
			"type": "object",
			"properties": {
				"privacyPolicy": {
					"type": "string"
				},
				"termsOfService": {
					"type": "string"
				}
			}
		}
	},
	"lexicon": 1
}
