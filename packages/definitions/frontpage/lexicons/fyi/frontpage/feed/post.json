{
	"id": "fyi.frontpage.feed.post",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["title", "createdAt", "subject"],
				"properties": {
					"title": {
						"type": "string",
						"maxLength": 3000,
						"description": "The title of the post.",
						"maxGraphemes": 300
					},
					"subject": {
						"refs": ["#urlSubject"],
						"type": "union",
						"description": "The piece of content that this Frontpage post is about."
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "Client-declared timestamp when this post was originally created."
					}
				}
			},
			"description": "Record containing a Frontpage post."
		},
		"urlSubject": {
			"type": "object",
			"required": ["url"],
			"properties": {
				"url": {
					"type": "string",
					"format": "uri"
				}
			}
		}
	},
	"lexicon": 1
}
