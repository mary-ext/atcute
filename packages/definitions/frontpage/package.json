{
	"name": "@atcute/frontpage",
	"version": "3.0.1",
	"description": "Frontpage (fyi.unravel.frontpage.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"frontpage"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/frontpage"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"pull": "lex-cli pull",
		"generate": "lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/frontpage": "file:",
		"@atcute/lex-cli": "workspace:^"
	},
	"peerDependencies": {
		"@atcute/lexicons": "^2.0.0"
	},
	"atcute:lexicons": {
		"mappings": {
			"fyi.unravel.frontpage.*": {
				"type": "namespace",
				"path": "./types/{{nsid}}"
			},
			"fyi.frontpage.*": {
				"type": "namespace",
				"path": "./types/{{nsid}}"
			}
		}
	}
}
