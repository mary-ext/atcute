{
	"type": "module",
	"name": "@atcute/frontpage",
	"version": "1.0.0",
	"description": "Frontpage (fyi.unravel.frontpage.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"frontpage"
	],
	"license": "MIT",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/frontpage"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/fyi/unravel/frontpage/*.js"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate -c ./lex.config.js",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/frontpage": "file:",
		"@atcute/lex-cli": "workspace:^",
		"vitest": "^3.1.3"
	}
}
