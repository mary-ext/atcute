{
	"id": "com.atproto.server.defs",
	"defs": {
		"inviteCode": {
			"type": "object",
			"required": ["available", "code", "createdAt", "createdBy", "disabled", "forAccount", "uses"],
			"properties": {
				"code": {
					"type": "string"
				},
				"uses": {
					"type": "array",
					"items": {
						"ref": "#inviteCodeUse",
						"type": "ref"
					}
				},
				"disabled": {
					"type": "boolean"
				},
				"available": {
					"type": "integer"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"createdBy": {
					"type": "string"
				},
				"forAccount": {
					"type": "string"
				}
			}
		},
		"inviteCodeUse": {
			"type": "object",
			"required": ["usedAt", "usedBy"],
			"properties": {
				"usedAt": {
					"type": "string",
					"format": "datetime"
				},
				"usedBy": {
					"type": "string",
					"format": "did"
				}
			}
		}
	},
	"lexicon": 1
}
