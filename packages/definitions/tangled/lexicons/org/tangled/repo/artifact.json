{
	"id": "org.tangled.repo.artifact",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["artifact", "createdAt", "name", "subject"],
				"properties": {
					"name": {
						"type": "string",
						"description": "name of the artifact"
					},
					"subject": {
						"refs": ["org.tangled.git.oid"],
						"type": "union"
					},
					"artifact": {
						"type": "blob",
						"accept": ["*/*"],
						"maxSize": 52428800,
						"description": "the artifact"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "time of creation of this artifact"
					}
				}
			}
		}
	},
	"lexicon": 1
}
