{
	"id": "org.tangled.repo.listCollaborators",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["items"],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#listItem",
								"type": "ref"
							}
						},
						"total": {
							"type": "integer",
							"description": "Total items in the full list; omitted for filtered or merged views"
						},
						"cursor": {
							"type": "string"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["subject"],
				"properties": {
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 1000,
						"minimum": 1
					},
					"order": {
						"type": "string",
						"default": "desc",
						"description": "Sort direction by effectiveSince.",
						"knownValues": ["asc", "desc"]
					},
					"cursor": {
						"type": "string",
						"description": "Pagination cursor"
					},
					"offset": {
						"type": "integer",
						"minimum": 0,
						"description": "Absolute offset for random-access pagination. Mutually exclusive with cursor; offsets drift under concurrent writes, so follow up with the returned cursor."
					},
					"subject": {
						"type": "string",
						"format": "did",
						"description": "Repo DID whose collaborator records to list."
					}
				}
			}
		},
		"listItem": {
			"type": "object",
			"required": ["addedBy", "createdAt", "effectiveSince", "subject"],
			"properties": {
				"cid": {
					"type": "string",
					"format": "cid",
					"description": "Optional record CID for record-backed indexers"
				},
				"uri": {
					"type": "string",
					"format": "at-uri",
					"description": "Optional record AT-URI for record-backed indexers"
				},
				"addedBy": {
					"type": "string",
					"format": "did",
					"description": "DID that added this collaborator"
				},
				"subject": {
					"type": "string",
					"format": "did",
					"description": "DID of the collaborator"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime",
					"description": "When the repository offered collaboration"
				},
				"verifiedAt": {
					"type": "string",
					"format": "datetime",
					"description": "When the knot resolved the collaborator's own acceptance record. Absent on a grant that predates the consent model."
				},
				"effectiveSince": {
					"type": "string",
					"format": "datetime",
					"description": "When the collaboration took effect. This listing sorts and pages on it."
				}
			}
		}
	},
	"lexicon": 1
}
