{
	"id": "org.tangled.repo.deleteRepo",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["repo"],
					"properties": {
						"repo": {
							"type": "string",
							"format": "did"
						},
						"force": {
