{
	"id": "org.tangled.secret.addSecret",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["key", "repo", "value"],
					"properties": {
						"key": {
							"type": "string",
							"maxLength": 50,
							"minLength": 1
						},
						"repo": {
							"type": "string",
							"format": "did"
						},
						"value": {
							"type": "string",
							"maxLength": 4096,
							"minLength": 1
						}
					}
				},
				"encoding": "application/json"
			},
			"errors": [
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				},
				{
					"name": "RepoNotFound",
					"description": "Repository not found"
				},
				{
					"name": "SecretAlreadyExists",
					"description": "A secret with this key already exists."
				}
			],
			"description": "Add a CI secret"
		}
	},
	"lexicon": 1
}
