{
	"id": "org.tangled.secret.removeSecret",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["key", "repo"],
					"properties": {
						"key": {
							"type": "string",
							"maxLength": 50,
							"minLength": 1
						},
						"repo": {
							"type": "string",
							"format": "did"
						}
					}
				},
				"encoding": "application/json"
			},
			"errors": [
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				},
				{
					"name": "RepoNotFound",
					"description": "Repository not found"
				},
				{
					"name": "SecretNotFound",
					"description": "The requested secret does not exist."
				}
			],
			"description": "Remove a CI secret"
		}
	},
	"lexicon": 1
}
