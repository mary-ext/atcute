{
	"id": "org.tangled.secret.listSecrets",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				},
				{
					"name": "RepoNotFound",
					"description": "Repository not found"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["secrets"],
					"properties": {
						"secrets": {
							"type": "array",
							"items": {
								"ref": "#secret",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo"],
				"properties": {
					"repo": {
						"type": "string",
						"format": "did"
					}
				}
			}
		},
		"secret": {
			"type": "object",
			"required": ["createdAt", "createdBy", "key"],
			"properties": {
				"key": {
					"type": "string",
					"maxLength": 50,
					"minLength": 1
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"createdBy": {
					"type": "string",
					"format": "did"
				}
			}
		}
	},
	"lexicon": 1
}
