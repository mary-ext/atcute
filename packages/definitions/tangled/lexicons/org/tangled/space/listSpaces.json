{
	"id": "org.tangled.space.listSpaces",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["spaces"],
					"properties": {
						"cursor": {
							"type": "string"
						},
						"spaces": {
							"type": "array",
							"items": {
								"ref": "#spaceView",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"properties": {
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 100,
						"minimum": 1,
						"description": "Count of spaces to return."
					},
					"cursor": {
						"type": "string"
					}
				}
			},
			"description": "Listing the private git repos that the caller is allowed to read."
		},
		"spaceView": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "did",
					"description": "The private git repo's DID."
				},
				"expiresAt": {
					"type": "string",
					"format": "datetime",
					"description": "When the indexer's lease on this repo gets nuked, unless a member refreshes it. This is left out when calling as a regular user and not as a full-on indexer."
				}
			}
		}
	},
	"lexicon": 1
}
