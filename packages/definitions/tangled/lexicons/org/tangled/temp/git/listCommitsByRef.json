{
	"id": "org.tangled.temp.git.listCommitsByRef",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "RefNotFound",
					"description": "Git reference not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["commits"],
					"properties": {
						"commits": {
							"type": "array",
							"items": {
								"ref": "org.tangled.temp.git.listCommits#commit",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo"],
				"properties": {
					"path": {
						"type": "string",
						"description": "Only list commits that changed this file or directory. Merges are compared with their first parent. The scan stops after a time budget and returns what it found, so a path untouched for very long can come back short."
					},
					"repo": {
						"type": "string",
						"format": "did",
						"description": "DID of the repository"
					},
					"skip": {
						"type": "integer",
						"default": 0,
						"minimum": 0,
						"description": "Number of matching commits to skip. A poor man's pagination."
					},
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 100,
						"minimum": 1,
						"description": "Maximum number of commits to return"
					},
					"ranges": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"includeStats": {
						"type": "boolean",
						"default": false,
						"description": "Diff each commit against its first parent and include a line stat"
					}
				}
			}
		}
	},
	"lexicon": 1
}
