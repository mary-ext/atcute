{
	"id": "org.tangled.temp.webhook.getDeliveriesForWebhooks",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["deliveries"],
					"properties": {
						"deliveries": {
							"type": "array",
							"items": {
								"ref": "#delivery",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["ids", "repoDid"],
				"properties": {
					"ids": {
						"type": "array",
						"items": {
							"type": "integer",
							"description": "Webhook ID."
						},
						"maxLength": 50
					},
					"limit": {
						"type": "integer",
						"default": 5,
						"maximum": 100,
						"minimum": 1
					},
					"repoDid": {
						"type": "string",
						"format": "did",
						"description": "DID of the repository as minted by the knot."
					}
				}
			},
			"description": "List recent delivery attempts for the given webhooks."
		},
		"delivery": {
			"type": "object",
			"required": ["createdAt", "deliveryId", "event", "id", "success", "url", "webhookId"],
			"properties": {
				"id": {
					"type": "integer"
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"event": {
					"type": "string",
					"description": "Event type that triggered the delivery."
				},
				"success": {
					"type": "boolean"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"webhookId": {
					"type": "integer"
				},
				"deliveryId": {
					"type": "string",
					"description": "UUID for tracking this delivery attempt."
				},
				"requestBody": {
					"type": "string"
				},
				"responseBody": {
					"type": "string"
				},
				"responseCode": {
					"type": "integer"
				}
			}
		}
	},
	"lexicon": 1
}
