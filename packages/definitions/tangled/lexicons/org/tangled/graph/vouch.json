{
	"id": "org.tangled.graph.vouch",
	"defs": {
		"main": {
			"key": "any",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt", "kind"],
				"properties": {
					"kind": {
						"enum": ["denounce", "vouch"],
						"type": "string",
						"default": "vouch",
						"description": "Whether this user is being vouched for or denounced"
					},
					"reason": {
						"type": "string",
						"maxLength": 2560,
						"description": "The reason for this vouch/denouncement",
						"maxGraphemes": 256
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"evidences": {
						"type": "array",
						"items": {
							"ref": "com.atproto.repo.strongRef",
							"type": "ref"
						},
						"maxLength": 10,
						"description": "Optional list of ATURIs serving as evidence for this vouch (ex. issues, PRs)"
					}
				}
			},
			"description": "normalized subject-DID as rkey."
		}
	},
	"lexicon": 1
}
