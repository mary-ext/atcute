{
	"id": "sh.tangled.graph.vouch",
	"defs": {
		"main": {
			"key": "any",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["kind", "createdAt"],
				"properties": {
					"kind": {
						"enum": ["vouch", "denounce"],
						"type": "string",
						"default": "vouch",
						"description": "Whether this user is being vouched for or denounced"
					},
					"reason": {
						"type": "string",
						"maxLength": 2560,
						"description": "The reason for this vouch/denouncement",
						"maxGraphemes": 256
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"evidences": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "at-uri"
						},
						"maxLength": 10,
						"description": "Optional list of ATURIs serving as evidence for this vouch (ex. issues, PRs)"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
