{
	"id": "sh.tangled.graph.vouch",
	"defs": {
		"main": {
			"key": "any",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["kind", "createdAt"],
				"properties": {
					"kind": {
						"enum": ["vouch", "denounce"],
						"type": "string",
						"default": "vouch",
						"description": "Whether this user is being vouched for or denounced"
					},
					"reason": {
						"type": "string",
						"maxLength": 2560,
						"description": "The reason for this vouch/denouncement",
						"maxGraphemes": 256
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
