{
	"id": "sh.tangled.git.temp.listLanguages",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "RefNotFound",
					"description": "Git reference not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["languages", "ref", "total"],
					"properties": {
						"ref": {
							"type": "string",
							"description": "The git reference used"
						},
						"total": {
							"type": "integer",
							"description": "Total size of all analyzed files in bytes"
						},
						"languages": {
							"type": "array",
							"items": {
								"ref": "#language",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo"],
				"properties": {
					"ref": {
						"type": "string",
						"default": "HEAD",
						"description": "Git reference (branch, tag, or commit SHA)"
					},
					"repo": {
						"type": "string",
						"format": "did",
						"description": "DID of the repository"
					}
				}
			}
		},
		"language": {
			"type": "object",
			"required": ["name", "size"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Programming language name"
				},
				"size": {
					"type": "integer",
					"description": "Total size of files in this language (bytes)"
				}
			}
		}
	},
	"lexicon": 1
}
