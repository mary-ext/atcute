{
	"id": "sh.tangled.git.temp.defs",
	"defs": {
		"tag": {
			"type": "object",
			"required": ["name", "tagger", "target"],
			"properties": {
				"name": {
					"type": "string",
					"description": "tag name"
				},
				"tagger": {
					"ref": "#signature",
					"type": "ref"
				},
				"target": {
					"type": "unknown"
				},
				"message": {
					"type": "string"
				}
			}
		},
		"hash": {
			"type": "string"
		},
		"branch": {
			"type": "object",
			"required": ["commit", "name"],
			"properties": {
				"name": {
					"type": "string",
					"description": "branch name"
				},
				"commit": {
					"ref": "#commit",
					"type": "ref",
					"description": "hydrated commit object"
				}
			}
		},
		"commit": {
			"type": "object",
			"required": ["author", "committer", "hash", "message", "tree"],
			"properties": {
				"hash": {
					"ref": "#hash",
					"type": "ref"
				},
				"tree": {
					"ref": "#hash",
					"type": "ref"
				},
				"author": {
					"ref": "#signature",
					"type": "ref"
				},
				"message": {
					"type": "string"
				},
				"committer": {
					"ref": "#signature",
					"type": "ref"
				}
			}
		},
		"signature": {
			"type": "object",
			"required": ["email", "name", "when"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Person name"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Timestamp of the signature"
				},
				"email": {
					"type": "string",
					"description": "Person email"
				}
			}
		},
		"submodule": {
			"type": "object",
			"required": ["name", "url"],
			"properties": {
				"url": {
					"type": "string",
					"description": "Submodule repository URL"
				},
				"name": {
					"type": "string",
					"description": "Submodule name"
				},
				"branch": {
					"type": "string",
					"description": "Branch to track in the submodule"
				}
			}
		}
	},
	"lexicon": 1
}
