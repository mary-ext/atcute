{
	"id": "sh.tangled.git.temp.defs",
	"defs": {
		"tag": {
			"type": "object",
			"required": ["name", "tagger", "target"],
			"properties": {
				"name": {
					"type": "string",
					"description": "tag name"
				},
				"tagger": {
					"ref": "#signature",
					"type": "ref"
				},
				"target": {
					"type": "unknown"
				},
				"message": {
					"type": "string"
				}
			}
		},
		"blob": {
			"type": "object",
			"required": ["name", "mode", "size", "lastCommit"],
			"properties": {
				"mode": {
					"type": "string"
				},
				"name": {
					"type": "string",
					"description": "The file name"
				},
				"size": {
					"type": "integer",
					"description": "File size in bytes"
				},
				"submodule": {
					"ref": "#submodule",
					"type": "ref",
					"description": "Submodule information if path is a submodule"
				},
				"lastCommit": {
					"ref": "#commit",
					"type": "ref"
				}
			},
			"description": "blob metadata. This object doesn't include the blob content"
		},
		"hash": {
			"type": "string"
		},
		"branch": {
			"type": "object",
			"required": ["name", "commit"],
			"properties": {
				"name": {
					"type": "string",
					"description": "branch name"
				},
				"commit": {
					"ref": "#commit",
					"type": "ref",
					"description": "hydrated commit object"
				}
			}
		},
		"commit": {
			"type": "object",
			"required": ["hash", "author", "committer", "message", "tree"],
			"properties": {
				"hash": {
					"ref": "#hash",
					"type": "ref"
				},
				"tree": {
					"ref": "#hash",
					"type": "ref"
				},
				"author": {
					"ref": "#signature",
					"type": "ref"
				},
				"message": {
					"type": "string"
				},
				"committer": {
					"ref": "#signature",
					"type": "ref"
				}
			}
		},
		"signature": {
			"type": "object",
			"required": ["name", "email", "when"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Person name"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Timestamp of the signature"
				},
				"email": {
					"type": "string",
					"description": "Person email"
				}
			}
		},
		"submodule": {
			"type": "object",
			"required": ["name", "url"],
			"properties": {
				"url": {
					"type": "string",
					"description": "Submodule repository URL"
				},
				"name": {
					"type": "string",
					"description": "Submodule name"
				},
				"branch": {
					"type": "string",
					"description": "Branch to track in the submodule"
				}
			}
		}
	},
	"lexicon": 1
}
