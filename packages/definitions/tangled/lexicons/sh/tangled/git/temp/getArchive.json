{
	"id": "sh.tangled.git.temp.getArchive",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "RefNotFound",
					"description": "Git reference not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				},
				{
					"name": "ArchiveError",
					"description": "Failed to create archive"
				}
			],
			"output": {
				"encoding": "*/*",
				"description": "Binary archive data"
			},
			"parameters": {
				"type": "params",
				"required": ["ref", "repo"],
				"properties": {
					"ref": {
						"type": "string",
						"description": "Git reference (branch, tag, or commit SHA)"
					},
					"repo": {
						"type": "string",
						"format": "at-uri",
						"description": "AT-URI of the repository"
					},
					"format": {
						"enum": ["tar", "tar.bz2", "tar.gz", "tar.xz", "zip"],
						"type": "string",
						"default": "tar.gz",
						"description": "Archive format"
					},
					"prefix": {
						"type": "string",
						"description": "Prefix for files in the archive"
					}
				}
			}
		}
	},
	"lexicon": 1
}
