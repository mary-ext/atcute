{
	"id": "sh.tangled.git.temp.analyzeMerge",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["is_conflicted"],
					"properties": {
						"conflicts": {
							"type": "array",
							"items": {
								"ref": "#conflictInfo",
								"type": "ref"
							},
							"description": "List of files with merge conflicts"
						},
						"is_conflicted": {
							"type": "boolean",
							"description": "Whether the merge has conflicts"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo", "patch", "branch"],
				"properties": {
					"repo": {
						"type": "string",
						"format": "at-uri",
						"description": "AT-URI of the repository"
					},
					"patch": {
						"type": "string",
						"description": "Patch or pull request to check for merge conflicts"
					},
					"branch": {
						"type": "string",
						"description": "Target branch to merge into"
					}
				}
			},
			"description": "Check if a merge is possible between two branches"
		},
		"conflictInfo": {
			"type": "object",
			"required": ["filename", "reason"],
			"properties": {
				"reason": {
					"type": "string",
					"description": "Reason for the conflict"
				},
				"filename": {
					"type": "string",
					"description": "Name of the conflicted file"
				}
			}
		}
	},
	"lexicon": 1
}
