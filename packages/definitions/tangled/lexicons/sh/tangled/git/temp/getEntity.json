{
	"id": "sh.tangled.git.temp.getEntity",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "BlobNotFound",
					"description": "Blob not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"ref": "sh.tangled.git.temp.defs#blob",
					"type": "ref"
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["path", "repo"],
				"properties": {
					"ref": {
						"type": "string",
						"default": "HEAD",
						"description": "Git reference (branch, tag, or commit SHA)"
					},
					"path": {
						"type": "string",
						"description": "path of the entity"
					},
					"repo": {
						"type": "string",
						"format": "at-uri",
						"description": "AT-URI of the repository"
					}
				}
			},
			"description": "get metadata of blob by ref and path"
		}
	},
	"lexicon": 1
}
