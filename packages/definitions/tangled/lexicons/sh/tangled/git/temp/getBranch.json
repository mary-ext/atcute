{
	"id": "sh.tangled.git.temp.getBranch",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "BranchNotFound",
					"description": "Branch not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["hash", "name", "when"],
					"properties": {
						"hash": {
							"type": "string",
							"description": "Latest commit hash on this branch"
						},
						"name": {
							"type": "string",
							"description": "Branch name"
						},
						"when": {
							"type": "string",
							"format": "datetime",
							"description": "Timestamp of latest commit"
						},
						"author": {
							"ref": "sh.tangled.git.temp.defs#signature",
							"type": "ref"
						},
						"message": {
							"type": "string",
							"description": "Latest commit message"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["name", "repo"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Branch name to get information for"
					},
					"repo": {
						"type": "string",
						"format": "at-uri",
						"description": "AT-URI of the repository"
					}
				}
			}
		}
	},
	"lexicon": 1
}
