{
	"id": "sh.tangled.git.refUpdate",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["committerDid", "meta", "newSha", "oldSha", "ref", "repo"],
				"properties": {
					"ref": {
						"type": "string",
						"maxLength": 2560,
						"description": "Ref being updated",
						"maxGraphemes": 256
					},
					"meta": {
						"ref": "#meta",
						"type": "ref"
					},
					"repo": {
						"type": "string",
						"format": "did",
						"description": "DID of the repo itself"
					},
					"newSha": {
						"type": "string",
						"maxLength": 40,
						"minLength": 40,
						"description": "new SHA of this ref"
					},
					"oldSha": {
						"type": "string",
						"maxLength": 40,
						"minLength": 40,
						"description": "old SHA of this ref"
					},
					"ownerDid": {
						"type": "string",
						"format": "did",
						"description": "did of the owner of the repo"
					},
					"committerDid": {
						"type": "string",
						"format": "did",
						"description": "did of the user that pushed this ref"
					}
				}
			},
			"description": "An update to a git repository, emitted by knots."
		},
		"meta": {
			"type": "object",
			"required": ["commitCount", "isDefaultRef"],
			"properties": {
				"commitCount": {
					"ref": "#commitCountBreakdown",
					"type": "ref"
				},
				"isDefaultRef": {
					"type": "boolean",
					"default": false
				},
				"langBreakdown": {
					"ref": "#langBreakdown",
					"type": "ref"
				}
			}
		},
		"langBreakdown": {
			"type": "object",
			"properties": {
				"inputs": {
					"type": "array",
					"items": {
						"ref": "#individualLanguageSize",
						"type": "ref"
					}
				}
			}
		},
		"commitCountBreakdown": {
			"type": "object",
			"required": [],
			"properties": {
				"byEmail": {
					"type": "array",
					"items": {
						"ref": "#individualEmailCommitCount",
						"type": "ref"
					}
				}
			}
		},
		"individualLanguageSize": {
			"type": "object",
			"required": ["lang", "size"],
			"properties": {
				"lang": {
					"type": "string"
				},
				"size": {
					"type": "integer"
				}
			}
		},
		"individualEmailCommitCount": {
			"type": "object",
			"required": ["count", "email"],
			"properties": {
				"count": {
					"type": "integer"
				},
				"email": {
					"type": "string"
				}
			}
		}
	},
	"lexicon": 1
}
