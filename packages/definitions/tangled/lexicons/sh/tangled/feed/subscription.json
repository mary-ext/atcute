{
	"id": "sh.tangled.feed.subscription",
	"defs": {
		"uri": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		},
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt", "subject"],
				"properties": {
					"subject": {
						"refs": ["#repo", "#uri"],
						"type": "union",
						"closed": true
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"collections": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Optional collection NSIDs to filter which notifications are sent. Empty or absent means all collections."
					}
				}
			}
		},
		"repo": {
			"type": "object",
			"required": ["did"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did"
				}
			}
		}
	},
	"lexicon": 1
}
