{
	"id": "sh.tangled.feed.star",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["subject", "createdAt"],
				"properties": {
					"subject": {
						"refs": ["#repo", "#string"],
						"type": "union",
						"closed": true
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		},
		"repo": {
			"type": "object",
			"required": ["did"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did"
				}
			}
		},
		"string": {
			"type": "object",
			"required": ["uri"],
			"properties": {
				"uri": {
					"type": "string",
					"format": "at-uri"
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
