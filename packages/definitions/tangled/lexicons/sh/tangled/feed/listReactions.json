{
	"id": "sh.tangled.feed.listReactions",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["items"],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#listItem",
								"type": "ref"
							}
						},
						"cursor": {
							"type": "string"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["subject"],
				"properties": {
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 1000,
						"minimum": 1
					},
					"order": {
						"type": "string",
						"default": "desc",
						"description": "Sort direction by createdAt.",
						"knownValues": ["asc", "desc"]
					},
					"cursor": {
						"type": "string",
						"description": "Pagination cursor"
					},
					"subject": {
						"type": "string",
						"format": "at-uri",
						"description": "Record AT-URI the reactions target."
					}
				}
			}
		},
		"listItem": {
			"type": "object",
			"required": ["uri", "value"],
			"properties": {
				"cid": {
					"type": "string",
					"format": "cid"
				},
				"uri": {
					"type": "string",
					"format": "at-uri"
				},
				"value": {
					"type": "unknown",
					"description": "Embedded sh.tangled.feed.reaction record"
				}
			}
		}
	},
	"lexicon": 1
}
