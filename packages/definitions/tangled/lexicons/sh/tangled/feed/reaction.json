{
	"id": "sh.tangled.feed.reaction",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["subject", "reaction", "createdAt"],
				"properties": {
					"subject": {
						"type": "string",
						"format": "at-uri"
					},
					"reaction": {
						"enum": ["👍", "👎", "😆", "🎉", "🫤", "❤️", "🚀", "👀"],
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
