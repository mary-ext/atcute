{
	"id": "sh.tangled.pipeline.status",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["pipeline", "workflow", "status", "createdAt"],
				"properties": {
					"error": {
						"type": "string",
						"description": "error message if failed"
					},
					"status": {
						"enum": ["pending", "running", "failed", "timeout", "cancelled", "success"],
						"type": "string",
						"description": "status of the workflow"
					},
					"exitCode": {
						"type": "integer",
						"description": "exit code if failed"
					},
					"pipeline": {
						"type": "string",
						"format": "at-uri",
						"description": "ATURI of the pipeline"
					},
					"workflow": {
						"type": "string",
						"format": "at-uri",
						"description": "name of the workflow within this pipeline"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "time of creation of this status update"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
