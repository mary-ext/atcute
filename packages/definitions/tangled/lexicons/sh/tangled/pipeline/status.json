{
	"id": "sh.tangled.pipeline.status",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt", "pipeline", "status", "workflow"],
				"properties": {
					"error": {
						"type": "string",
						"description": "error message if failed"
					},
					"status": {
						"enum": ["cancelled", "failed", "pending", "running", "success", "timeout"],
						"type": "string",
						"description": "status of the workflow"
					},
					"exitCode": {
						"type": "integer",
						"description": "exit code if failed"
					},
					"pipeline": {
						"type": "string",
						"format": "at-uri",
						"description": "ATURI of the pipeline"
					},
					"workflow": {
						"type": "string",
						"format": "at-uri",
						"description": "name of the workflow within this pipeline"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "time of creation of this status update"
					}
				},
				"description": "DEPRECATED: use sh.tangled.ci.pipeline instead"
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
