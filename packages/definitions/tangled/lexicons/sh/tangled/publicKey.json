{
	"id": "sh.tangled.publicKey",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["key", "name", "createdAt"],
				"properties": {
					"key": {
						"type": "string",
						"maxLength": 4096,
						"description": "public key contents"
					},
					"name": {
						"type": "string",
						"description": "human-readable name for this key"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "key upload timestamp"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
