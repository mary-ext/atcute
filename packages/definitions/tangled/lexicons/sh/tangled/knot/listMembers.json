{
	"id": "sh.tangled.knot.listMembers",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["items"],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#listItem",
								"type": "ref"
							}
						},
						"cursor": {
							"type": "string"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["subject"],
				"properties": {
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 1000,
						"minimum": 1
					},
					"order": {
						"type": "string",
						"default": "desc",
						"description": "Sort direction by createdAt.",
						"knownValues": ["asc", "desc"]
					},
					"cursor": {
						"type": "string",
						"description": "Pagination cursor"
					},
					"subject": {
						"type": "string",
						"description": "Knot identifier whose member records to list."
					}
				}
			}
		},
		"listItem": {
			"type": "object",
			"required": ["addedBy", "createdAt", "subject"],
			"properties": {
				"cid": {
					"type": "string",
					"format": "cid",
					"description": "Optional record CID for record-backed indexers"
				},
				"uri": {
					"type": "string",
					"format": "at-uri",
					"description": "Optional record AT-URI for record-backed indexers"
				},
				"addedBy": {
					"type": "string",
					"format": "did",
					"description": "DID that added this member"
				},
				"subject": {
					"type": "string",
					"format": "did",
					"description": "DID of the member"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime",
					"description": "When the member was added"
				}
			}
		}
	},
	"lexicon": 1
}
