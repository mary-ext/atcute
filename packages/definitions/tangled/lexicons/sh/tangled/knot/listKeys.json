{
	"id": "sh.tangled.knot.listKeys",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "InternalServerError",
					"description": "Failed to retrieve public keys"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["keys"],
					"properties": {
						"keys": {
							"type": "array",
							"items": {
								"ref": "#publicKey",
								"type": "ref"
							}
						},
						"cursor": {
							"type": "string",
							"description": "Pagination cursor for next page"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"properties": {
					"limit": {
						"type": "integer",
						"default": 100,
						"maximum": 1000,
						"minimum": 1,
						"description": "Maximum number of keys to return"
					},
					"cursor": {
						"type": "string",
						"description": "Pagination cursor"
					}
				}
			},
			"description": "List all public keys stored in the knot server"
		},
		"publicKey": {
			"type": "object",
			"required": ["createdAt", "did", "key"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did",
					"description": "DID associated with the public key"
				},
				"key": {
					"type": "string",
					"maxLength": 4096,
					"description": "Public key contents"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime",
					"description": "Key upload timestamp"
				}
			}
		}
	},
	"lexicon": 1
}
