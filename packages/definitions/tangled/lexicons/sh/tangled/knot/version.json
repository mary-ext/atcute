{
	"id": "sh.tangled.knot.version",
	"defs": {
		"main": {
			"type": "query",
			"errors": [],
			"output": {
				"schema": {
					"type": "object",
					"required": ["version"],
					"properties": {
						"version": {
							"type": "string"
						},
						"capabilities": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"description": "Protocol capability tokens this knot implements, such as knot-acl. Knots that omit this field are treated as legacy."
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Get the version of a knot"
		}
	},
	"lexicon": 1
}
