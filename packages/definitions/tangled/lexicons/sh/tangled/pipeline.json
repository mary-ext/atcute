{
	"id": "sh.tangled.pipeline",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["triggerMetadata", "workflows"],
				"properties": {
					"workflows": {
						"type": "array",
						"items": {
							"ref": "#workflow",
							"type": "ref"
						}
					},
					"triggerMetadata": {
						"ref": "#triggerMetadata",
						"type": "ref"
					}
				},
				"description": "DEPRECATED: use sh.tangled.ci.pipeline instead"
			}
		},
		"pair": {
			"type": "object",
			"required": ["key", "value"],
			"properties": {
				"key": {
					"type": "string"
				},
				"value": {
					"type": "string"
				}
			}
		},
		"workflow": {
			"type": "object",
			"required": ["clone", "engine", "name", "raw"],
			"properties": {
				"raw": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"clone": {
					"ref": "#cloneOpts",
					"type": "ref"
				},
				"engine": {
					"type": "string"
				},
				"runsOn": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"cloneOpts": {
			"type": "object",
			"required": ["depth", "skip", "submodules", "tags"],
			"properties": {
				"skip": {
					"type": "boolean"
				},
				"tags": {
					"type": "boolean"
				},
				"depth": {
					"type": "integer"
				},
				"submodules": {
					"type": "boolean"
				}
			}
		},
		"triggerRepo": {
			"type": "object",
			"required": ["defaultBranch", "did", "knot"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did"
				},
				"knot": {
					"type": "string"
				},
				"repo": {
					"type": "string"
				},
				"repoDid": {
					"type": "string",
					"format": "did",
					"description": "DID of the repo itself"
				},
				"defaultBranch": {
					"type": "string"
				}
			}
		},
		"pushTriggerData": {
			"type": "object",
			"required": ["newSha", "oldSha", "ref"],
			"properties": {
				"ref": {
					"type": "string"
				},
				"newSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				},
				"oldSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				}
			}
		},
		"triggerMetadata": {
			"type": "object",
			"required": ["kind", "repo"],
			"properties": {
				"kind": {
					"enum": ["manual", "pull_request", "push"],
					"type": "string"
				},
				"push": {
					"ref": "#pushTriggerData",
					"type": "ref"
				},
				"repo": {
					"ref": "#triggerRepo",
					"type": "ref"
				},
				"manual": {
					"ref": "#manualTriggerData",
					"type": "ref"
				},
				"sourceRepo": {
					"type": "string",
					"format": "did",
					"description": "Repository DID that code and workflow definitions are checked out from, when different from repo (e.g. a fork's commit for a fork-based manual trigger). If absent, source uses repo itself."
				},
				"pullRequest": {
					"ref": "#pullRequestTriggerData",
					"type": "ref"
				}
			}
		},
		"manualTriggerData": {
			"type": "object",
			"required": ["sha"],
			"properties": {
				"ref": {
					"type": "string",
					"description": "optional ref the SHA was resolved from, for display and TANGLED_REF"
				},
				"sha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40,
					"description": "commit SHA the manual run targets"
				},
				"inputs": {
					"type": "array",
					"items": {
						"ref": "#pair",
						"type": "ref"
					}
				}
			}
		},
		"pullRequestTriggerData": {
			"type": "object",
			"required": ["sourceBranch", "sourceSha", "targetBranch"],
			"properties": {
				"pull": {
					"type": "string",
					"format": "at-uri",
					"description": "AT-URI of the sh.tangled.repo.pull record this run belongs to"
				},
				"action": {
					"enum": ["closed", "merged", "opened", "reopened", "synchronize"],
					"type": "string",
					"description": "the pull request lifecycle action that produced this trigger"
				},
				"sourceSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				},
				"sourceBranch": {
					"type": "string"
				},
				"targetBranch": {
					"type": "string"
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
