{
	"id": "sh.tangled.pipeline",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["triggerMetadata", "workflows"],
				"properties": {
					"workflows": {
						"type": "array",
						"items": {
							"ref": "#workflow",
							"type": "ref"
						}
					},
					"triggerMetadata": {
						"ref": "#triggerMetadata",
						"type": "ref"
					}
				}
			}
		},
		"pair": {
			"type": "object",
			"required": ["key", "value"],
			"properties": {
				"key": {
					"type": "string"
				},
				"value": {
					"type": "string"
				}
			}
		},
		"workflow": {
			"type": "object",
			"required": ["name", "engine", "clone", "raw"],
			"properties": {
				"raw": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"clone": {
					"ref": "#cloneOpts",
					"type": "ref"
				},
				"engine": {
					"type": "string"
				}
			}
		},
		"cloneOpts": {
			"type": "object",
			"required": ["skip", "depth", "submodules"],
			"properties": {
				"skip": {
					"type": "boolean"
				},
				"depth": {
					"type": "integer"
				},
				"submodules": {
					"type": "boolean"
				}
			}
		},
		"triggerRepo": {
			"type": "object",
			"required": ["knot", "did", "defaultBranch"],
			"properties": {
				"did": {
					"type": "string",
					"format": "did"
				},
				"knot": {
					"type": "string"
				},
				"repo": {
					"type": "string"
				},
				"repoDid": {
					"type": "string",
					"format": "did",
					"description": "DID of the repo itself"
				},
				"defaultBranch": {
					"type": "string"
				}
			}
		},
		"pushTriggerData": {
			"type": "object",
			"required": ["ref", "newSha", "oldSha"],
			"properties": {
				"ref": {
					"type": "string"
				},
				"newSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				},
				"oldSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				}
			}
		},
		"triggerMetadata": {
			"type": "object",
			"required": ["kind", "repo"],
			"properties": {
				"kind": {
					"enum": ["push", "pull_request", "manual"],
					"type": "string"
				},
				"push": {
					"ref": "#pushTriggerData",
					"type": "ref"
				},
				"repo": {
					"ref": "#triggerRepo",
					"type": "ref"
				},
				"manual": {
					"ref": "#manualTriggerData",
					"type": "ref"
				},
				"pullRequest": {
					"ref": "#pullRequestTriggerData",
					"type": "ref"
				}
			}
		},
		"manualTriggerData": {
			"type": "object",
			"properties": {
				"inputs": {
					"type": "array",
					"items": {
						"ref": "#pair",
						"type": "ref"
					}
				}
			}
		},
		"pullRequestTriggerData": {
			"type": "object",
			"required": ["sourceBranch", "targetBranch", "sourceSha", "action"],
			"properties": {
				"action": {
					"type": "string"
				},
				"sourceSha": {
					"type": "string",
					"maxLength": 40,
					"minLength": 40
				},
				"sourceBranch": {
					"type": "string"
				},
				"targetBranch": {
					"type": "string"
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
