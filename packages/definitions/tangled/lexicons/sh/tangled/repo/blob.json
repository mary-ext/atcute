{
	"id": "sh.tangled.repo.blob",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "RefNotFound",
					"description": "Git reference not found"
				},
				{
					"name": "FileNotFound",
					"description": "File not found at the specified path"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["path", "ref"],
					"properties": {
						"ref": {
							"type": "string",
							"description": "The git reference used"
						},
						"path": {
							"type": "string",
							"description": "The file path"
						},
						"size": {
							"type": "integer",
							"description": "File size in bytes"
						},
						"content": {
							"type": "string",
							"description": "File content (base64 encoded for binary files)"
						},
						"encoding": {
							"enum": ["base64", "utf-8"],
							"type": "string",
							"description": "Content encoding"
						},
						"isBinary": {
							"type": "boolean",
							"description": "Whether the file is binary"
						},
						"mimeType": {
							"type": "string",
							"description": "MIME type of the file"
						},
						"submodule": {
							"ref": "#submodule",
							"type": "ref",
							"description": "Submodule information if path is a submodule"
						},
						"lastCommit": {
							"ref": "#lastCommit",
							"type": "ref"
						},
						"fileTooLarge": {
							"type": "boolean"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["path", "ref", "repo"],
				"properties": {
					"raw": {
						"type": "boolean",
						"default": false,
						"description": "Return raw file content instead of JSON response"
					},
					"ref": {
						"type": "string",
						"description": "Git reference (branch, tag, or commit SHA)"
					},
					"path": {
						"type": "string",
						"description": "Path to the file within the repository"
					},
					"repo": {
						"type": "string",
						"description": "Repository identifier in format 'did:plc:.../repoName'"
					}
				}
			}
		},
		"signature": {
			"type": "object",
			"required": ["email", "name", "when"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Author name"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Author timestamp"
				},
				"email": {
					"type": "string",
					"description": "Author email"
				}
			}
		},
		"submodule": {
			"type": "object",
			"required": ["name", "url"],
			"properties": {
				"url": {
					"type": "string",
					"description": "Submodule repository URL"
				},
				"name": {
					"type": "string",
					"description": "Submodule name"
				},
				"branch": {
					"type": "string",
					"description": "Branch to track in the submodule"
				}
			}
		},
		"lastCommit": {
			"type": "object",
			"required": ["hash", "message", "when"],
			"properties": {
				"hash": {
					"type": "string",
					"description": "Commit hash"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Commit timestamp"
				},
				"author": {
					"ref": "#signature",
					"type": "ref"
				},
				"message": {
					"type": "string",
					"description": "Commit message"
				}
			}
		}
	},
	"lexicon": 1
}
