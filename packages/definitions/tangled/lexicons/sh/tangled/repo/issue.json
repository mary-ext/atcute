{
	"id": "sh.tangled.repo.issue",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["title", "createdAt"],
				"properties": {
					"body": {
						"type": "string"
					},
					"repo": {
						"type": "string",
						"format": "at-uri"
					},
					"title": {
						"type": "string"
					},
					"repoDid": {
						"type": "string",
						"format": "did"
					},
					"mentions": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "did"
						}
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"references": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "at-uri"
						}
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
