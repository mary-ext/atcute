{
	"id": "sh.tangled.repo.branch",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "BranchNotFound",
					"description": "Branch not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["hash", "name", "when"],
					"properties": {
						"hash": {
							"type": "string",
							"description": "Latest commit hash on this branch"
						},
						"name": {
							"type": "string",
							"description": "Branch name"
						},
						"when": {
							"type": "string",
							"format": "datetime",
							"description": "Timestamp of latest commit"
						},
						"author": {
							"ref": "#signature",
							"type": "ref"
						},
						"message": {
							"type": "string",
							"description": "Latest commit message"
						},
						"isDefault": {
							"type": "boolean",
							"description": "Whether this is the default branch"
						},
						"shortHash": {
							"type": "string",
							"description": "Short commit hash"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["name", "repo"],
				"properties": {
					"name": {
						"type": "string",
						"description": "Branch name to get information for"
					},
					"repo": {
						"type": "string",
						"description": "Repository identifier in format 'did:plc:.../repoName'"
					}
				}
			}
		},
		"signature": {
			"type": "object",
			"required": ["email", "name", "when"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Author name"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Author timestamp"
				},
				"email": {
					"type": "string",
					"description": "Author email"
				}
			}
		}
	},
	"lexicon": 1
}
