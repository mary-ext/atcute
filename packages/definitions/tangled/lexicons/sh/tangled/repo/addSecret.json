{
	"id": "sh.tangled.repo.addSecret",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["key", "repo", "value"],
					"properties": {
						"key": {
							"type": "string",
							"maxLength": 50,
							"minLength": 1
						},
						"repo": {
							"type": "string",
							"format": "at-uri"
						},
						"value": {
							"type": "string",
							"maxLength": 200,
							"minLength": 1
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Add a CI secret"
		}
	},
	"lexicon": 1
}
