{
	"id": "sh.tangled.repo.listPulls",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["items"],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#pullListItem",
								"type": "ref"
							}
						},
						"cursor": {
							"type": "string"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["subject"],
				"properties": {
					"limit": {
						"type": "integer",
						"default": 50,
						"maximum": 1000,
						"minimum": 1
					},
					"order": {
						"type": "string",
						"default": "desc",
						"description": "Sort direction by createdAt.",
						"knownValues": ["asc", "desc"]
					},
					"author": {
						"type": "string",
						"format": "did",
						"description": "Restrict to pulls authored by this user DID."
					},
					"cursor": {
						"type": "string",
						"description": "Pagination cursor"
					},
					"status": {
						"type": "string",
						"description": "Restrict to pulls whose latest derived status matches.",
						"knownValues": ["closed", "merged", "open"]
					},
					"subject": {
						"type": "string",
						"format": "did",
						"description": "Repo DID to list pulls for"
					}
				}
			}
		},
		"pullListItem": {
			"type": "object",
			"required": ["commentCount", "state", "uri", "value"],
			"properties": {
				"cid": {
					"type": "string",
					"format": "cid"
				},
				"uri": {
					"type": "string",
					"format": "at-uri"
				},
				"state": {
					"type": "string",
					"description": "Latest derived state.",
					"knownValues": ["closed", "merged", "open"]
				},
				"value": {
					"type": "unknown",
					"description": "Embedded sh.tangled.repo.pull record"
				},
				"commentCount": {
					"type": "integer",
					"minimum": 0,
					"description": "Count of sh.tangled.repo.pull.comment records targeting this pull."
				},
				"stateUpdatedAt": {
					"type": "string",
					"format": "datetime",
					"description": "TID-derived timestamp of the latest pull status record."
				}
			}
		}
	},
	"lexicon": 1
}
