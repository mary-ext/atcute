							"type": "string",
							"format": "did"
						}
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"references": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "at-uri"
						}
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
