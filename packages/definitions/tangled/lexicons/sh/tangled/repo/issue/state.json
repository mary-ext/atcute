{
	"id": "sh.tangled.repo.issue.state",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["createdAt", "issue", "state"],
				"properties": {
					"issue": {
						"type": "string",
						"format": "at-uri"
					},
					"state": {
						"type": "string",
						"default": "sh.tangled.repo.issue.state.open",
						"description": "state of the issue",
						"knownValues": ["sh.tangled.repo.issue.state.closed", "sh.tangled.repo.issue.state.open"]
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
