{
	"id": "sh.tangled.repo.listSecrets",
	"defs": {
		"main": {
			"type": "query",
			"output": {
				"schema": {
					"type": "object",
					"required": ["secrets"],
					"properties": {
						"secrets": {
							"type": "array",
							"items": {
								"ref": "#secret",
								"type": "ref"
							}
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo"],
				"properties": {
					"repo": {
						"type": "string",
						"format": "at-uri"
					}
				}
			}
		},
		"secret": {
			"type": "object",
			"required": ["repo", "key", "createdAt", "createdBy"],
			"properties": {
				"key": {
					"type": "string",
					"maxLength": 50,
					"minLength": 1
				},
				"repo": {
					"type": "string",
					"format": "at-uri"
				},
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"createdBy": {
					"type": "string",
					"format": "did"
				}
			}
		}
	},
	"lexicon": 1
}
