{
	"id": "sh.tangled.repo.create",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["rkey", "name"],
					"properties": {
						"name": {
							"type": "string",
							"description": "Name of the repository"
						},
						"rkey": {
							"type": "string",
							"description": "Rkey of the repository record"
						},
						"source": {
							"type": "string",
							"description": "A source URL to clone from, populate this when forking or importing a repository."
						},
						"repoDid": {
							"type": "string",
							"format": "did",
							"description": "Optional user-provided did:web to use as the repo identity instead of minting a did:plc."
						},
						"defaultBranch": {
							"type": "string",
							"description": "Default branch to push to"
						}
					}
				},
				"encoding": "application/json"
			},
			"output": {
				"schema": {
					"type": "object",
					"properties": {
						"repoDid": {
							"type": "string",
							"format": "did"
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Create a new repository"
		}
	},
	"lexicon": 1
}
