{
	"id": "sh.tangled.repo.tag",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "TagNotFound",
					"description": "Tag not found"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"encoding": "*/*"
			},
			"parameters": {
				"type": "params",
				"required": ["repo", "tag"],
				"properties": {
					"tag": {
						"type": "string",
						"description": "Name of tag, such as v1.3.0"
					},
					"repo": {
						"type": "string",
						"description": "Repository identifier in format 'did:plc:.../repoName'"
					}
				}
			}
		}
	},
	"lexicon": 1
}
