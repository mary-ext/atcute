{
	"id": "sh.tangled.repo.pull",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["target", "title", "createdAt", "rounds"],
				"properties": {
					"body": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"rounds": {
						"type": "array",
						"items": {
							"ref": "#round",
							"type": "ref"
						}
					},
					"source": {
						"ref": "#source",
						"type": "ref"
					},
					"target": {
						"ref": "#target",
						"type": "ref"
					},
					"mentions": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "did"
						}
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"references": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "at-uri"
						}
					},
					"dependentOn": {
						"type": "string",
						"format": "at-uri"
					}
				}
			}
		},
		"round": {
			"type": "object",
			"required": ["patchBlob", "createdAt"],
			"properties": {
				"createdAt": {
					"type": "string",
					"format": "datetime"
				},
				"patchBlob": {
					"type": "blob",
					"accept": ["application/gzip"]
				}
			},
			"description": "revisions of this pull request, newer rounds are appended to this array. appviews may reject records do not treat this field as append-only. the blob format is gzipped text-based git-format-patches."
		},
		"source": {
			"type": "object",
			"required": ["branch"],
			"properties": {
				"repo": {
					"type": "string",
					"format": "did"
				},
				"branch": {
					"type": "string"
				}
			}
		},
		"target": {
			"type": "object",
			"required": ["repo", "branch"],
			"properties": {
				"repo": {
					"type": "string",
					"format": "did"
				},
				"branch": {
					"type": "string"
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
