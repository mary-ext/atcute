{
	"id": "sh.tangled.repo.tree",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "RepoNotFound",
					"description": "Repository not found or access denied"
				},
				{
					"name": "RefNotFound",
					"description": "Git reference not found"
				},
				{
					"name": "PathNotFound",
					"description": "Path not found in repository tree"
				},
				{
					"name": "InvalidRequest",
					"description": "Invalid request parameters"
				}
			],
			"output": {
				"schema": {
					"type": "object",
					"required": ["ref", "files"],
					"properties": {
						"ref": {
							"type": "string",
							"description": "The git reference used"
						},
						"files": {
							"type": "array",
							"items": {
								"ref": "#treeEntry",
								"type": "ref"
							}
						},
						"dotdot": {
							"type": "string",
							"description": "Parent directory path"
						},
						"parent": {
							"type": "string",
							"description": "The parent path in the tree"
						},
						"readme": {
							"ref": "#readme",
							"type": "ref",
							"description": "Readme for this file tree"
						},
						"lastCommit": {
							"ref": "#lastCommit",
							"type": "ref"
						}
					}
				},
				"encoding": "application/json"
			},
			"parameters": {
				"type": "params",
				"required": ["repo", "ref"],
				"properties": {
					"ref": {
						"type": "string",
						"description": "Git reference (branch, tag, or commit SHA)"
					},
					"path": {
						"type": "string",
						"default": "",
						"description": "Path within the repository tree"
					},
					"repo": {
						"type": "string",
						"description": "Repository identifier in format 'did:plc:.../repoName'"
					}
				}
			}
		},
		"readme": {
			"type": "object",
			"required": ["filename", "contents"],
			"properties": {
				"contents": {
					"type": "string",
					"description": "Contents of the readme file"
				},
				"filename": {
					"type": "string",
					"description": "Name of the readme file"
				}
			}
		},
		"signature": {
			"type": "object",
			"required": ["name", "email", "when"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Author name"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Author timestamp"
				},
				"email": {
					"type": "string",
					"description": "Author email"
				}
			}
		},
		"treeEntry": {
			"type": "object",
			"required": ["name", "mode", "size"],
			"properties": {
				"mode": {
					"type": "string",
					"description": "File mode"
				},
				"name": {
					"type": "string",
					"description": "Relative file or directory name"
				},
				"size": {
					"type": "integer",
					"description": "File size in bytes"
				},
				"last_commit": {
					"ref": "#lastCommit",
					"type": "ref"
				}
			}
		},
		"lastCommit": {
			"type": "object",
			"required": ["hash", "message", "when"],
			"properties": {
				"hash": {
					"type": "string",
					"description": "Commit hash"
				},
				"when": {
					"type": "string",
					"format": "datetime",
					"description": "Commit timestamp"
				},
				"author": {
					"ref": "#signature",
					"type": "ref"
				},
				"message": {
					"type": "string",
					"description": "Commit message"
				}
			}
		}
	},
	"lexicon": 1
}
