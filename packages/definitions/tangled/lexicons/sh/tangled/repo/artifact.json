{
	"id": "sh.tangled.repo.artifact",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["artifact", "createdAt", "name", "tag"],
				"properties": {
					"tag": {
						"type": "bytes",
						"maxLength": 20,
						"minLength": 20,
						"description": "hash of the tag object that this artifact is attached to (only annotated tags are supported)"
					},
					"name": {
						"type": "string",
						"description": "name of the artifact"
					},
					"repo": {
						"type": "string",
						"format": "at-uri",
						"description": "repo that this artifact is being uploaded to"
					},
					"repoDid": {
						"type": "string",
						"format": "did"
					},
					"artifact": {
						"type": "blob",
						"accept": ["*/*"],
						"maxSize": 52428800,
						"description": "the artifact"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime",
						"description": "time of creation of this artifact"
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
