{
	"id": "sh.tangled.repo.delete",
	"defs": {
		"main": {
			"type": "procedure",
			"input": {
				"schema": {
					"type": "object",
					"required": ["did", "name", "rkey"],
					"properties": {
						"did": {
							"type": "string",
							"format": "did",
							"description": "DID of the repository owner"
						},
						"name": {
							"type": "string",
							"description": "Name of the repository to delete"
						},
						"rkey": {
							"type": "string",
							"format": "record-key",
							"description": "Rkey of the repository record"
						},
						"force": {
							"type": "boolean",
							"description": "Admin-only. Delete even though the repository record still exists on the owner's PDS."
						}
					}
				},
				"encoding": "application/json"
			},
			"description": "Delete a repository"
		}
	},
	"lexicon": 1
}
