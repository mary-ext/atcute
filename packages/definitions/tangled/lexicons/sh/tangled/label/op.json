{
	"id": "sh.tangled.label.op",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["add", "delete", "performedAt", "subject"],
				"properties": {
					"add": {
						"type": "array",
						"items": {
							"ref": "#operand",
							"type": "ref"
						}
					},
					"delete": {
						"type": "array",
						"items": {
							"ref": "#operand",
							"type": "ref"
						}
					},
					"subject": {
						"type": "string",
						"format": "at-uri",
						"description": "The subject (task, pull or discussion) of this label. Appviews may apply a `scope` check and refuse this op."
					},
					"performedAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			}
		},
		"operand": {
			"type": "object",
			"required": ["key", "value"],
			"properties": {
				"key": {
					"type": "string",
					"format": "at-uri",
					"description": "ATURI to the label definition"
				},
				"value": {
					"type": "string",
					"description": "Stringified value of the label. This is first unstringed by appviews and then interpreted as a concrete value."
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
