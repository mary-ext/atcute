{
	"id": "sh.tangled.actor.profile",
	"defs": {
		"main": {
			"key": "literal:self",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["bluesky"],
				"properties": {
					"links": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uri",
							"description": "Any URI, intended for social profiles or websites, can be used to link DIDs/AT-URIs too."
						},
						"maxLength": 5,
						"minLength": 0
					},
					"stats": {
						"type": "array",
						"items": {
							"enum": [
								"closed-issue-count",
								"closed-pull-request-count",
								"merged-pull-request-count",
								"open-issue-count",
								"open-pull-request-count",
								"repository-count",
								"star-count"
							],
							"type": "string",
							"description": "Vanity stats."
						},
						"maxLength": 2,
						"minLength": 0
					},
					"avatar": {
						"type": "blob",
						"accept": ["image/jpeg", "image/png"],
						"maxSize": 1000000,
						"description": "Small image to be displayed next to posts from account. AKA, 'profile picture'"
					},
					"bluesky": {
						"type": "boolean",
						"description": "Include link to this account on Bluesky."
					},
					"location": {
						"type": "string",
						"maxLength": 400,
						"description": "Free-form location text.",
						"maxGraphemes": 40
					},
					"pronouns": {
						"type": "string",
						"maxLength": 40,
						"description": "Preferred gender pronouns."
					},
					"description": {
						"type": "string",
						"maxLength": 2560,
						"description": "Free-form profile description text.",
						"maxGraphemes": 256
					},
					"preferredHandle": {
						"type": "string",
						"format": "handle",
						"maxLength": 253,
						"description": "A handle the user prefers to be displayed as."
					},
					"pinnedRepositories": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"maxLength": 6,
						"minLength": 0,
						"description": "Pinned repositories. Values are repo DIDs for repos that have them, or AT-URIs for legacy repos."
					}
				}
			},
			"description": "A declaration of a Tangled account profile."
		}
	},
	"lexicon": 1
}
