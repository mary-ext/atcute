{
	"id": "sh.tangled.repo",
	"defs": {
		"main": {
			"key": "tid",
			"type": "record",
			"record": {
				"type": "object",
				"required": ["name", "knot", "createdAt"],
				"properties": {
					"knot": {
						"type": "string",
						"description": "knot where the repo was created"
					},
					"name": {
						"type": "string",
						"description": "name of the repo"
					},
					"labels": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "at-uri"
						},
						"description": "List of labels that this repo subscribes to"
					},
					"source": {
						"type": "string",
						"format": "uri",
						"description": "source of the repo"
					},
					"topics": {
						"type": "array",
						"items": {
							"type": "string",
							"maxLength": 50,
							"minLength": 1
						},
						"maxLength": 50,
						"description": "Topics related to the repo"
					},
					"repoDid": {
						"type": "string",
						"format": "did",
						"description": "DID of the repo itself, if assigned"
					},
					"spindle": {
						"type": "string",
						"description": "CI runner to send jobs to and receive results from"
					},
					"website": {
						"type": "string",
						"format": "uri",
						"description": "Any URI related to the repo"
					},
					"createdAt": {
						"type": "string",
						"format": "datetime"
					},
					"description": {
						"type": "string",
						"maxGraphemes": 140,
						"minGraphemes": 1
					}
				}
			}
		}
	},
	"lexicon": 1,
	"needsCbor": true,
	"needsType": true
}
