{
	"name": "@atcute/tangled",
	"version": "1.0.19",
	"description": "Tangled (sh.tangled.*) schema definitions",
	"keywords": [
		"atcute",
		"atproto",
		"tangled"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/definitions/tangled"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/sh/tangled/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"pull": "lex-cli pull",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/tangled": "file:"
	},
	"atcute:lexicons": {
		"mappings": {
			"sh.tangled.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
