{
	"name": "@atcute/oauth-crypto",
	"version": "0.1.0",
	"description": "crypto helpers for AT Protocol OAuth",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/crypto"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./lib/index.ts"
	},
	"publishConfig": {
