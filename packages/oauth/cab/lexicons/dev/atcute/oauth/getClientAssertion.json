{
	"defs": {
		"main": {
			"description": "get a DPoP-bound client assertion for OAuth token requests",
			"errors": [
				{
					"name": "InvalidDpopProof",
					"description": "DPoP proof is missing or invalid"
				},
				{
					"name": "UseDpopNonce",
					"description": "retry with the provided DPoP-Nonce"
				}
			],
			"input": {
				"encoding": "application/json",
				"schema": {
					"properties": {
						"aud": {
							"type": "string",
							"description": "authorization server issuer"
						}
					},
					"required": ["aud"],
					"type": "object"
				}
			},
			"output": {
				"encoding": "application/json",
				"schema": {
					"properties": {
						"client_assertion": {
							"type": "string",
							"description": "signed JWT assertion"
						}
					},
					"required": ["client_assertion"],
					"type": "object"
				}
			},
			"type": "procedure"
		}
	},
	"id": "dev.atcute.oauth.getClientAssertion",
	"lexicon": 1
}
