{
	"name": "@atcute/oauth-cab",
	"version": "0.1.0",
	"description": "Client Assertion Backend (CAB) for AT Protocol OAuth browser clients",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/cab"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./client": "./dist/client/index.js",
		"./server": "./dist/server/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo -b",
		"generate": "rm -r ./lib/lexicons/; lex-cli generate",
		"export": "lex-cli export",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/client": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@atcute/oauth-crypto": "workspace:^",
		"@atcute/oauth-keyset": "workspace:^",
		"@atcute/oauth-types": "workspace:^",
		"@atcute/uint8array": "workspace:^",
		"@atcute/xrpc-server": "workspace:^"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@atcute/lexicon-doc": "workspace:^",
		"@atcute/oauth-browser-client": "workspace:^",
		"@atcute/oauth-cab": "file:",
		"vitest": "^4.0.16"
	},
	"peerDependencies": {
		"@atcute/oauth-browser-client": "^2.0.3"
	},
	"peerDependenciesMeta": {
		"@atcute/oauth-browser-client": {
			"optional": true
		}
	}
}
