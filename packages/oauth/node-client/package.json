{
	"name": "@atcute/oauth-node-client",
	"version": "2.0.1",
	"description": "atproto OAuth client for Node.js and other server runtimes",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/node-client"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/client": "workspace:^",
		"@atcute/identity": "workspace:^",
		"@atcute/identity-resolver": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/oauth-crypto": "workspace:^",
		"@atcute/oauth-keyset": "workspace:^",
		"@atcute/oauth-types": "workspace:^",
		"@atcute/util-fetch": "workspace:^",
		"nanoid": "^5.1.16",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.4",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"@atcute/identity-resolver": "^2.0.0",
		"@atcute/lexicons": "^2.0.0"
	}
}
