{
	"name": "@atcute/oauth-browser-client",
	"version": "3.0.0",
	"description": "minimal OAuth browser client implementation for AT Protocol",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/browser-client"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/client": "workspace:^",
		"@atcute/identity-resolver": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@atcute/oauth-crypto": "workspace:^",
		"@atcute/oauth-types": "workspace:^",
		"nanoid": "^5.1.7"
	}
}
