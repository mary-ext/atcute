{
	"type": "module",
	"name": "@atcute/oauth-browser-client",
	"version": "1.0.22",
	"description": "minimal OAuth browser client implementation for AT Protocol",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/browser-client"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"postbuild": "node ./scripts/ensure-files.js",
		"test": "bun test --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/client": "workspace:^",
		"@atcute/identity": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@atcute/uint8array": "workspace:^"
	},
	"devDependencies": {
		"@atcute/atproto": "workspace:^"
	}
}
