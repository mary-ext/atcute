{
	"name": "@atcute/oauth-types",
	"version": "0.1.0",
	"description": "OAuth types and schemas for AT Protocol",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/oauth/types"
	},
	"files": [
