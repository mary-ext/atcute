{
	"type": "module",
	"name": "@atcute/car",
	"version": "3.1.3",
	"description": "lightweight DASL CAR and atproto repository decoder for AT Protocol.",
	"keywords": [
		"atproto",
		"dasl",
		"car"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/car"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js",
		"./car-reader": "./dist/car-reader/index.js",
		"./repo-reader": "./dist/repo-reader/index.js",
		"./v4": "./dist/index.js",
		"./v4/car-reader": "./dist/car-reader/index.js",
		"./v4/repo-reader": "./dist/repo-reader/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "bun test --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"devDependencies": {
		"@atcute/multibase": "workspace:^",
		"@types/bun": "^1.2.21"
	},
	"dependencies": {
		"@atcute/cbor": "workspace:^",
		"@atcute/cid": "workspace:^",
		"@atcute/uint8array": "workspace:^",
		"@atcute/varint": "workspace:^",
		"yocto-queue": "^1.2.1"
	}
}
