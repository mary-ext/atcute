{
	"type": "module",
	"name": "@atcute/repo",
	"version": "0.1.1",
	"description": "AT Protocol repository decoder for AT Protocol.",
	"keywords": [
		"atproto",
		"repo"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/repo"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest run --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"devDependencies": {
		"@atcute/multibase": "workspace:^",
		"@vitest/coverage-v8": "^4.0.16",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"@atcute/car": "workspace:^",
		"@atcute/cbor": "workspace:^",
		"@atcute/cid": "workspace:^",
		"@atcute/crypto": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/mst": "workspace:^",
		"@atcute/uint8array": "workspace:^"
	}
}
