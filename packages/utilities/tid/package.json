{
	"name": "@atcute/tid",
	"version": "1.1.4",
	"description": "atproto timestamp identifier codec library",
	"keywords": [
		"atproto",
		"codec"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://tangled.org/did:plc:pljn5qch4tgadongtc7i6qij",
		"directory": "packages/utilities/tid"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#platform/random": {
			"node": "./dist/random-node.js",
			"default": "./dist/random-web.js"
		}
	},
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/time-ms": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"vitest": "^4.1.10"
	}
}
