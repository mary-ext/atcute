{
	"type": "module",
	"name": "@atcute/tid",
	"version": "1.1.0",
	"description": "atproto timestamp identifier codec library",
	"keywords": [
		"atproto",
		"codec"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/tid"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"imports": {
		"#platform/random": {
			"node": "./dist/random-node.js",
			"default": "./dist/random-web.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/time-ms": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^22.19.3",
		"vitest": "^4.0.16"
	}
}
