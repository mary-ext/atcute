{
	"name": "@atcute/cbor",
	"version": "2.3.1",
	"description": "lightweight DASL dCBOR42 codec library for AT Protocol",
	"keywords": [
		"atproto",
		"cbor",
		"dasl"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/cbor"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#runtime": {
			"workerd": "./lib/runtime.ts",
			"node": "./lib/runtime.node.ts",
			"default": "./lib/runtime.ts"
		}
	},
	"exports": {
		".": "./lib/index.ts",
		"./bytes": "./lib/bytes.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./bytes": "./dist/bytes.js"
		},
		"imports": {
			"#runtime": {
				"workerd": "./dist/runtime.js",
				"node": "./dist/runtime.node.js",
				"default": "./dist/runtime.js"
			}
		}
	},
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/cid": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@atcute/uint8array": "workspace:^"
	},
	"devDependencies": {
		"@ipld/dag-cbor": "^9.2.5",
		"@types/node": "^25.2.1",
		"@vitest/coverage-v8": "^4.0.18",
		"cbor-x": "^1.6.0",
		"vitest": "^4.0.18"
	}
}
