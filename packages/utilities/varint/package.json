{
	"name": "@atcute/varint",
	"version": "2.0.0",
	"description": "protobuf-style LEB128 varint codec library",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/varint"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
