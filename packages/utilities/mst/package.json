{
	"name": "@atcute/mst",
	"version": "1.0.0",
	"description": "atproto MST manipulation utilities",
	"keywords": [
		"atproto",
		"mst",
		"repo"
	],
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/mst"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"generate-tests": "cd mst-test-suite && mise exec -- uv run python scripts/generate_exhaustive_cars.py",
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest run",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/cbor": "workspace:^",
		"@atcute/cid": "workspace:^",
		"@atcute/uint8array": "workspace:^"
	},
	"devDependencies": {
		"@atcute/car": "workspace:^",
		"@badrap/valita": "^0.4.6",
		"@types/node": "^25.3.2",
		"@vitest/coverage-v8": "^4.0.18",
		"vitest": "^4.0.18"
	}
}
