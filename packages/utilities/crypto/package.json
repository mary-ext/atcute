{
	"type": "module",
	"name": "@atcute/crypto",
	"version": "2.0.0",
	"description": "lightweight atproto cryptographic library",
	"keywords": [
		"atproto",
		"cryptography",
		"p256",
		"nistp256",
		"k256",
		"secp256k1"
	],
	"license": "MIT",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/utilities/crypto"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"imports": {
		"#keypairs/secp256k1": {
			"--atcute-develop-node": "./lib/keypairs/secp256k1.node.ts",
			"--atcute-develop": "./lib/keypairs/secp256k1.ts",
			"bun": "./dist/keypairs/secp256k1.js",
			"node": "./dist/keypairs/secp256k1.node.js",
			"default": "./dist/keypairs/secp256k1.js"
		}
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "bun test --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"devDependencies": {
		"@noble/curves": "^1.7.0",
		"@types/bun": "^1.1.14"
	},
	"dependencies": {
		"@atcute/multibase": "workspace:^",
		"@noble/secp256k1": "^2.1.0"
	}
}
