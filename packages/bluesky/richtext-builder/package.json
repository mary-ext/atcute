{
	"name": "@atcute/bluesky-richtext-builder",
	"version": "2.0.5",
	"description": "builder pattern for Bluesky's rich text facets",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/bluesky/richtext-builder"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/bluesky": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/uint8array": "workspace:^"
	}
}
