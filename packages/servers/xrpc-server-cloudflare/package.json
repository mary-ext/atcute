{
	"name": "@atcute/xrpc-server-cloudflare",
	"version": "1.0.0",
	"description": "Cloudflare Workers WebSocket adapter for @atcute/xrpc-server",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/servers/xrpc-server-cloudflare"
	},
	"files": [
		"dist/",
		"lib/",
