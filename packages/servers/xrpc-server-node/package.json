{
	"name": "@atcute/xrpc-server-node",
	"version": "0.1.0",
	"description": "Node.js WebSocket adapter for @atcute/xrpc-server",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/servers/xrpc-server-node"
	},
	"files": [
