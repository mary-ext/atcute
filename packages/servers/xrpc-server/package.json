{
	"name": "@atcute/xrpc-server",
	"version": "2.1.0",
	"description": "a small web framework for handling XRPC operations",
	"license": "0BSD",
	"repository": {
		"url": "https://tangled.org/did:plc:pljn5qch4tgadongtc7i6qij",
		"directory": "packages/servers/xrpc-server"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"exports": {
		".": "./dist/main/index.js",
		"./auth": "./dist/auth/index.js",
