{
	"type": "module",
	"name": "@atcute/xrpc-server",
	"version": "0.1.3",
	"description": "a small web framework for handling XRPC operations",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/servers/xrpc-server"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"exports": {
		".": "./dist/main/index.js",
		"./auth": "./dist/auth/index.js",
		"./middlewares/cors": "./dist/middlewares/cors.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/cbor": "workspace:^",
		"@atcute/crypto": "workspace:^",
		"@atcute/identity": "workspace:^",
		"@atcute/identity-resolver": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@atcute/multibase": "workspace:^",
		"@atcute/uint8array": "workspace:^",
		"@badrap/valita": "^0.4.6",
		"nanoid": "^5.1.6"
	},
	"devDependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/xrpc-server": "file:",
		"@types/node": "^22.19.1",
		"@vitest/coverage-v8": "^4.0.14",
		"vitest": "^4.0.14"
	}
}
