{
	"name": "@atcute/labeler",
	"version": "0.1.0",
	"description": "a lightweight core for building AT Protocol labelers",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/servers/labeler"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/cbor": "workspace:^",
		"@atcute/crypto": "workspace:^",
		"@atcute/lexicons": "^1.2.9",
		"@mary-ext/simple-event-emitter": "^1.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.2.3",
		"@vitest/coverage-v8": "^4.0.18",
		"vitest": "^4.0.18"
	}
}
