{
	"name": "@atcute/util-text-native",
	"version": "1.0.3",
	"description": "internal text utilities with native grapheme counting",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/misc/util-text-native"
	},
	"files": [
		"dist/",
		"!dist/**/*.bench.js",
		"!dist/**/*.test.js",
		"prebuilds/**/*.node",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"react-native": "./dist/index.rn.js",
			"node": "./dist/index.node.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:native": "node build.native.js",
		"build": "tsgo",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build:native; pnpm run build"
	},
	"dependencies": {
		"unicode-segmenter": "^0.14.5"
	},
	"devDependencies": {
		"@types/node": "^25.9.4",
		"vitest": "^4.1.9",
		"zig-build": "^0.3.0"
	}
}
