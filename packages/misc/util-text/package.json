{
	"name": "@atcute/util-text",
	"version": "1.2.0",
	"description": "internal text utilities",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/misc/util-text"
	},
	"files": [
		"dist/",
		"lib/",
		"prebuilds/**/*.node",
		"src/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"react-native": "./dist/index.rn.js",
			"node": "./dist/index.node.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:native": "node build.native.js",
		"build": "tsgo --project tsconfig.build.json",
		"test": "vitest",
		"prepublish": "rm -rf dist; pnpm run build:native; pnpm run build"
	},
	"dependencies": {
		"unicode-segmenter": "^0.14.5"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"vitest": "^4.1.2",
		"zig-build": "^0.3.0"
	}
}
