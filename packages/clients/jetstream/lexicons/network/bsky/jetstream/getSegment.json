{
	"id": "network.bsky.jetstream.getSegment",
	"defs": {
		"main": {
			"type": "query",
			"errors": [
				{
					"name": "SegmentNotFound"
				}
			],
			"output": {
				"encoding": "application/octet-stream"
			},
			"parameters": {
				"type": "params",
				"required": ["name"],
				"properties": {
					"name": {
						"type": "string",
						"description": "The segment filename, e.g. seg_000000002a.jss"
					}
				}
			},
			"description": "Download a sealed segment file by name."
		}
	},
	"lexicon": 1
}
