{
	"name": "@atcute/jetstream",
	"version": "2.2.0",
	"description": "lightweight and cute Jetstream subscriber for AT Protocol",
	"license": "0BSD",
	"repository": {
		"url": "https://tangled.org/did:plc:pljn5qch4tgadongtc7i6qij",
		"directory": "packages/clients/jetstream"
	},
	"files": [
		"dist/",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./types/*": "./dist/lexicons/types/network/bsky/jetstream/*.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"generate": "lex-cli generate",
		"pull": "lex-cli pull",
		"test": "vitest run",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/firehose": "workspace:^",
		"@atcute/lexicons": "workspace:^",
		"@mary-ext/event-iterator": "^1.1.0",
		"@mary-ext/simple-event-emitter": "^1.0.2",
		"partysocket": "^1.3.0",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@atcute/lex-cli": "workspace:^",
		"@types/ws": "^8.18.1",
		"vitest": "^4.1.11",
		"ws": "^8.21.3"
	},
	"peerDependencies": {
		"@atcute/lexicons": "^2.0.0"
	},
	"atcute:lexicons": {
		"mappings": {
			"network.bsky.jetstream.*": {
				"type": "namespace",
				"path": "./types/{{nsid_remainder}}"
			}
		}
	}
}
