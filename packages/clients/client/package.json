{
	"name": "@atcute/client",
	"version": "5.0.0",
	"description": "lightweight and cute API client for AT Protocol",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/clients/client"
	},
	"files": [
		"dist/",
		"lib/",
		"!lib/**/*.bench.ts",
		"!lib/**/*.test.ts",
		"!dist/**/*.{test,bench}.*"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsgo",
		"postbuild": "node ./scripts/ensure-files.js",
		"test": "vitest run --coverage",
		"prepublish": "rm -rf dist; pnpm run build"
	},
	"dependencies": {
		"@atcute/identity": "workspace:^",
		"@atcute/lexicons": "workspace:^"
	},
	"devDependencies": {
		"@atcute/atproto": "workspace:^",
		"@atcute/bluesky": "workspace:^",
		"@atcute/internal-dev-env": "workspace:^",
		"@vitest/coverage-v8": "^4.1.5",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@atcute/lexicons": "^2.0.0"
	}
}
