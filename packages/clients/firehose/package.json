{
	"name": "@atcute/firehose",
	"version": "0.1.0",
	"description": "lightweight and cute XRPC subscription client for AT Protocol",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/clients/firehose"
	},
	"files": [
		"dist/",
		"lib/",
