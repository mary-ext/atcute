{
	"type": "module",
	"name": "@atcute/tap",
	"version": "0.1.1",
	"description": "an atproto Tap client",
	"license": "0BSD",
	"repository": {
		"url": "https://github.com/mary-ext/atcute",
		"directory": "packages/clients/tap"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
